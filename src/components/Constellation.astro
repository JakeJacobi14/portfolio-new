---
// The central element (DESIGN.md §8, ADR 0008, ADR 0009): the commit constellation, drawn
// as a night sky. Every star is a real commit to this repo, oldest at the center. Laid out
// at build time; the script below only handles hover, focus and tap.
import realCommits from "../data/commits.json";
import { sky, day, REPO, PAD, BOX, type Commit, type Star } from "../lib/constellation";

let commits: Commit[] = realCommits;
// DEV ONLY: `FAKE_COMMITS=500 npm run dev` swaps in fake data to test other sizes.
if (import.meta.env.DEV && process.env.FAKE_COMMITS) {
  const { fakeCommits } = await import("../dev/fake-commits");
  commits = fakeCommits(Number(process.env.FAKE_COMMITS));
}

const { stars, figures, labels, dust } = sky(commits);
const n = stars.length;
const newest = stars[n - 1];
const recent = stars.slice(-10).reverse();
const tones = ["warm", "cool", "neutral"] as const;
const toneVar = { warm: "--star-warm", cool: "--star-cool", neutral: "--star" };
const viewBox = `${-PAD} ${-PAD} ${BOX} ${BOX}`;
const pct = (u: number) => `${((u + PAD) / BOX) * 100}%`;
// The sky layers reach PAD past the stars' 0..100 square on every side.
const layer = `inset: ${(-PAD / 100) * 100}%`;
const label = n
  ? `Commit constellation: ${n} commits to this site drawn as stars, from ${day(stars[0].date)} to ${day(newest.date)}, oldest at the center. Each one links to the commit on GitHub; arrow keys move between them.`
  : "Commit constellation: no commits yet.";
const describe = (s: Star) => `${s.short}, ${day(s.date)}: ${s.subject}`;
---
<figure class="constellation" data-constellation>
  <div class="c-frame" data-c-frame>
    <div class="c-layer c-sky" style={layer}>
    <svg viewBox={viewBox} role="group" aria-label={label}>
      <defs>
        {tones.map((t) => (
          <radialGradient id={`c-halo-${t}`}>
            <stop offset="0" style={`stop-color: var(${toneVar[t]}); stop-opacity: 0.28`} />
            <stop offset="0.3" style={`stop-color: var(${toneVar[t]}); stop-opacity: 0.085`} />
            <stop offset="1" style={`stop-color: var(${toneVar[t]}); stop-opacity: 0`} />
          </radialGradient>
        ))}
      </defs>
      {dust.map((b) => (
        <g class="c-dust" data-c-dust={b.band} aria-hidden="true">
          <path class="c-dust-a" d={b.faint} />
          <path class="c-dust-b" d={b.light} />
        </g>
      ))}
      <g aria-hidden="true">
        {figures.map((f, fi) => (
          <g class="c-fig" data-c-fig={fi}>
            {f.lines.map(([a, b]) => (
              <line x1={stars[a].x} y1={stars[a].y} x2={stars[b].x} y2={stars[b].y} pathLength="1" data-c-line />
            ))}
          </g>
        ))}
      </g>
      {stars.map((s) => (
        <a
          href={`${REPO}/commit/${s.hash}`}
          target="_blank"
          rel="noopener"
          tabindex={s === newest ? 0 : -1}
          aria-label={describe(s)}
          data-c-node
          data-x={s.x}
          data-y={s.y}
          data-r={s.r}
          data-short={s.short}
          data-date={day(s.date)}
          data-subject={s.subject}
          data-tags={s.tags.join(" ") || undefined}
          data-fig={s.figure ?? undefined}
        >
          <g
            class:list={["c-star", `tone-${s.tone}`, { "c-tw": s.twinkle !== null }]}
            style={`--o:${s.o}; --tw-f:${s.twinkle ?? 0}; --tw-delay:-${s.twinkleDelay}s`}
          >
            {s.bright && <circle class="c-halo" cx={s.x} cy={s.y} r={s.r * 3.2} fill={`url(#c-halo-${s.tone})`} />}
            <circle class="c-core" cx={s.x} cy={s.y} r={s.r} />
          </g>
        </a>
      ))}
      <g class="c-fx" data-c-fx aria-hidden="true"></g>
    </svg>
    </div>
    <!-- Focus ring and milestone labels, outside the edge fade so they stay readable. -->
    <div class="c-layer" style={layer}>
      <svg viewBox={viewBox} aria-hidden="true" focusable="false">
        <circle class="c-ring" r="0" data-c-ring />
      </svg>
      {labels.map((l) => (
        <span class="c-label" style={`left:${pct(l.x)}; top:${pct(l.y)}`} data-c-label-for={l.figure} aria-hidden="true">
          {l.text}
        </span>
      ))}
    </div>
    <div class="c-tip mono" data-c-tip hidden aria-hidden="true">
      <span class="c-tip-meta" data-c-tip-meta></span>
      <span data-c-tip-subject></span>
    </div>
  </div>
  <figcaption class="mono" data-frame>every star is a commit to this site. oldest at the center.</figcaption>
  <div class="visually-hidden">
    <p>{n > 10 ? `Commits ${n - 9} to ${n} of ${n}:` : `All ${n} commits:`}</p>
    <ol>
      {recent.map((s) => <li><a href={`${REPO}/commit/${s.hash}`} tabindex="-1">{describe(s)}</a></li>)}
    </ol>
  </div>
</figure>

<style>
  /* The caption sits centered under the sky (ADR 0015). */
  .constellation { margin: 0; display: flex; flex-direction: column; align-items: center; }
  /* The frame is the stars' 0..100 square; it has no visible edge (ADR 0012). */
  .c-frame { position: relative; width: 100%; aspect-ratio: 1; }
  .c-layer { position: absolute; pointer-events: none; }
  .c-layer svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .c-sky svg { pointer-events: auto; }
  /* Outer stars fade toward the edge so the sky has no boundary. */
  .c-sky {
    -webkit-mask-image: radial-gradient(closest-side, #000 40%, transparent 92%);
    mask-image: radial-gradient(closest-side, #000 40%, transparent 92%);
  }
  /* Before the build-in script runs, the sky is empty. */
  :global(.is-building) [data-constellation] :is([data-c-node], [data-c-dust], [data-c-fig], .c-label) { opacity: 0; }

  /* Stars (DESIGN.md §8): filled points, near-white with a slight temperature shift. */
  /* --near (0..1, set by the script) lifts a star a little as the pointer comes close. */
  .c-star { --lit: calc(var(--o) + (1 - var(--o)) * var(--near, 0) * 0.4); opacity: var(--lit); }
  .c-core {
    fill: var(--star);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(1 + var(--near, 0) * 0.2));
  }
  .tone-warm .c-core { fill: var(--star-warm); }
  .tone-cool .c-core { fill: var(--star-cool); }
  .c-tw {
    animation: c-twinkle calc(var(--twinkle-min) + (var(--twinkle-max) - var(--twinkle-min)) * var(--tw-f))
      var(--ease) var(--tw-delay) infinite alternate;
  }
  @keyframes c-twinkle { to { opacity: calc(var(--lit) * 0.45); } }

  .c-dust path { fill: var(--star); }
  .c-dust-a { opacity: 0.1; }
  .c-dust-b { opacity: 0.2; }

  [data-c-node] {
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity var(--dur-ui) var(--ease);
  }
  [data-c-node]:focus { outline: none; } /* the accent ring is the focus indicator */

  /* Build-in effects (DESIGN.md §8): a ping ring when a star is placed, a short trail. */
  .c-fx :global(.c-ping) { fill: none; stroke: var(--star); stroke-width: 0.15; }
  .c-fx :global(.c-trail) { fill: none; stroke: var(--muted); stroke-width: 0.2; stroke-linecap: round; opacity: 0.35; }
  .c-fig {
    stroke: var(--muted);
    stroke-width: 0.18;
    stroke-linecap: round;
    opacity: 0.25;
    transition: opacity var(--dur-ui) var(--ease);
  }
  .c-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.45;
    opacity: 0;
    pointer-events: none;
  }

  .c-label {
    position: absolute;
    line-height: 1.3;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity var(--dur-ui) var(--ease);
  }

  /* Hovering a milestone: its figure brightens, the rest of the sky dims. */
  .c-dust { transition: opacity var(--dur-ui) var(--ease); }
  [data-focus] .c-dust,
  [data-focus] .c-label:not([data-lit]) { opacity: 0.45; }
  [data-focus] .c-fig:not([data-lit]) { opacity: 0.11; }
  .c-fig[data-lit] { opacity: 0.6; }

  .c-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    display: grid;
    gap: var(--space-1);
    width: max-content;
    max-width: min(36ch, 90%);
    padding: var(--space-2) var(--space-3);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: var(--radius);
    pointer-events: none;
  }
  .c-tip[hidden] { display: none; }
  .c-tip-meta { color: var(--muted); }

  /* One line wherever the sky is wide enough; otherwise two balanced lines. */
  figcaption { width: fit-content; margin-top: var(--space-3); color: var(--muted); text-align: center; text-wrap: balance; }

  @media (prefers-reduced-motion: reduce) {
    .c-tw { animation: none; }
    [data-c-node], .c-fig, .c-label, .c-dust { transition: none; }
  }
</style>

<script>
  import { PAD, BOX } from "../lib/constellation";
  const fig = document.querySelector<HTMLElement>("[data-constellation]");
  const frame = fig?.querySelector<HTMLElement>("[data-c-frame]");
  if (fig && frame) {
    const svg = fig.querySelector("svg")!;
    const links = [...fig.querySelectorAll<SVGAElement>("[data-c-node]")];
    const pts = links.map((a) => ({ x: Number(a.dataset.x), y: Number(a.dataset.y), r: Number(a.dataset.r) }));
    const figs = [...fig.querySelectorAll<SVGGElement>("[data-c-fig]")];
    const labels = [...fig.querySelectorAll<HTMLElement>(".c-label")];
    const ring = fig.querySelector<SVGCircleElement>("[data-c-ring]")!;
    const tip = fig.querySelector<HTMLElement>("[data-c-tip]")!;
    const tipMeta = fig.querySelector<HTMLElement>("[data-c-tip-meta]")!;
    const tipSubject = fig.querySelector<HTMLElement>("[data-c-tip-subject]")!;
    // Only while the hero (and so the sky) is being built; later sections don't matter here.
    const building = () => document.documentElement.classList.contains("hero-building") || document.documentElement.classList.contains("is-building");
    let active = -1;

    /** Hovering a milestone: light up its figure, dim the rest of the sky. One generated
        rule instead of touching every star keeps this cheap at 500 stars. */
    const focusRule = document.createElement("style");
    document.head.append(focusRule);
    const focusFigure = (f: string | undefined) => {
      frame.toggleAttribute("data-focus", f !== undefined);
      focusRule.textContent = f === undefined ? "" : `[data-c-frame][data-focus] [data-c-node]:not([data-fig="${f}"]) { opacity: 0.45; }`;
      for (const g of figs) g.toggleAttribute("data-lit", f !== undefined && g.dataset.cFig === f);
      for (const l of labels) l.toggleAttribute("data-lit", f !== undefined && l.dataset.cLabelFor === f);
    };

    const place = (i: number) => {
      const p = pts[i];
      const w = frame.clientWidth, h = frame.clientHeight;
      const tw = tip.offsetWidth, th = tip.offsetHeight;
      const cx = (p.x / 100) * w;
      const gap = 10 + (p.r / 100) * w;
      const above = (p.y / 100) * h - gap - th;
      const top = above >= 0 ? above : (p.y / 100) * h + gap;
      const left = Math.min(Math.max(cx - tw / 2, 0), w - tw);
      tip.style.transform = `translate(${left}px, ${top}px)`;
    };

    const show = (i: number) => {
      if (i === active) return;
      active = i;
      if (i < 0) {
        tip.hidden = true;
        ring.style.opacity = "0";
        focusFigure(undefined);
        return;
      }
      const a = links[i], p = pts[i];
      ring.setAttribute("cx", String(p.x));
      ring.setAttribute("cy", String(p.y));
      ring.setAttribute("r", String(Math.max(p.r + 0.9, 1.5)));
      ring.style.opacity = "1";
      const tags = a.dataset.tags ? ` · ${a.dataset.tags}` : "";
      tipMeta.textContent = `${a.dataset.short} · ${a.dataset.date}${tags}`;
      tipSubject.textContent = a.dataset.subject ?? "";
      tip.hidden = false;
      place(i);
      focusFigure(a.dataset.tags ? a.dataset.fig : undefined);
    };

    /** The star nearest a pointer, if it's close enough to mean that star. The stars are
        tiny, so the reach is generous: about 13px for a mouse, 20px for a finger. */
    const nearest = (e: { clientX: number; clientY: number }, reach: number) => {
      const b = svg.getBoundingClientRect();
      const x = ((e.clientX - b.left) / b.width) * BOX - PAD;
      const y = ((e.clientY - b.top) / b.height) * BOX - PAD;
      const units = (reach / b.width) * BOX;
      let best = -1, bestD = Infinity;
      pts.forEach((p, k) => {
        const d = Math.hypot(p.x - x, p.y - y);
        if (d < Math.max(p.r * 2.5, units) && d < bestD) { best = k; bestD = d; }
      });
      return best;
    };

    let pointerType = "mouse";
    svg.addEventListener("pointerdown", (e) => { pointerType = e.pointerType; });
    svg.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse" || building()) return;
      const i = nearest(e, 13);
      svg.style.cursor = i >= 0 ? "pointer" : "";
      show(i);
    });
    svg.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") show(-1); });
    svg.addEventListener("click", (e) => {
      if (e.detail === 0) return; // keyboard Enter: let the focused link open itself
      e.preventDefault();
      if (building()) return;
      const touch = pointerType !== "mouse";
      const i = nearest(e, touch ? 20 : 13);
      // Touch: the first tap shows the tooltip, a second tap on the same star opens it.
      if (touch && i !== active) return show(i);
      if (i >= 0) window.open(links[i].href.baseVal, "_blank", "noopener");
    });
    document.addEventListener("pointerdown", (e) => {
      if (active >= 0 && !fig.contains(e.target as Node)) show(-1);
    });

    // Keyboard: one tab stop, arrow keys step through commits in order.
    links.forEach((a, i) => a.addEventListener("focus", () => show(i)));
    fig.addEventListener("focusout", (e) => {
      if (!fig.contains(e.relatedTarget as Node)) show(-1);
    });
    svg.addEventListener("keydown", (e) => {
      const i = links.indexOf(document.activeElement as SVGAElement);
      if (i < 0) return;
      const to = { ArrowRight: i + 1, ArrowUp: i + 1, ArrowLeft: i - 1, ArrowDown: i - 1, Home: 0, End: links.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      const next = Math.min(Math.max(to, 0), links.length - 1);
      links[i].setAttribute("tabindex", "-1");
      links[next].setAttribute("tabindex", "0");
      links[next].focus();
    });
    addEventListener("resize", () => { if (active >= 0) place(active); });

    /* Stars notice the pointer (ADR 0016): within NEAR px they brighten and grow slightly,
       with a soft falloff by distance, eased in and out. Mouse only, never while the hero is
       being built, off for reduced motion. Only stars whose value changes are touched. */
    const NEAR = 120, TAU = 140; // px, ms
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const root = document.documentElement;
    const starEls = links.map((a) => a.querySelector<SVGGElement>(".c-star")!);
    const near = new Float32Array(links.length);
    const shown = new Float32Array(links.length); // last value written to the page
    let px = -1e5, py = -1e5, raf = 0, last = 0;
    const step = (now: number) => {
      raf = 0;
      const k = 1 - Math.exp(-Math.min(64, now - last) / TAU);
      last = now;
      const off = still.matches || building();
      const r = svg.getBoundingClientRect();
      const scale = r.width / BOX;
      const far = off || px < r.left - NEAR || px > r.right + NEAR || py < r.top - NEAR || py > r.bottom + NEAR;
      let moving = false;
      for (let i = 0; i < pts.length; i++) {
        let t = 0;
        if (!far) {
          const d = Math.hypot(r.left + (pts[i].x + PAD) * scale - px, r.top + (pts[i].y + PAD) * scale - py);
          if (d < NEAR) { const f = 1 - d / NEAR; t = f * f * (3 - 2 * f); }
        }
        if (t === 0 && near[i] === 0) continue;
        let v = near[i] + (t - near[i]) * k;
        if (Math.abs(t - v) < 0.004) v = t; else moving = true;
        near[i] = v;
        if (Math.abs(v - shown[i]) > 0.002 || (v === t && v !== shown[i])) {
          shown[i] = v;
          if (v === 0) starEls[i].style.removeProperty("--near");
          else starEls[i].style.setProperty("--near", v.toFixed(3));
        }
      }
      if (moving) raf = requestAnimationFrame(step);
    };
    const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(step); } };
    addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse" || !fine.matches) return;
      px = e.clientX; py = e.clientY;
      kick();
    }, { passive: true });
    document.addEventListener("pointerleave", () => { px = py = -1e5; kick(); });
    addEventListener("scroll", () => { if (px > -1e5) kick(); }, { passive: true });
  }
</script>
