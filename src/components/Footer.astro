---
import RegMarks from "./RegMarks.astro";
---
<footer class="footer section container grid mono" data-footer>
  <RegMarks bottom />
  <p data-type>Built with Claude Code. The process is documented in the repo.</p>
  <button type="button" class="replay" data-replay data-drag="replay">Replay build</button>
</footer>

<style>
  .footer {
    row-gap: var(--space-4);
    margin-bottom: var(--space-9);
    color: var(--muted);
  }
  p { grid-column: 1 / -1; }
  .replay { grid-column: 1 / -1; justify-self: start; }
  @media (min-width: 960px) {
    p { grid-column: 1 / 9; }
    .replay { grid-column: 9 / -1; justify-self: end; }
  }
  .replay {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--dur-micro) var(--ease);
  }
  .replay:hover { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .replay { display: none; }
  }
</style>
