---
// The agents' control bar: fixed to the bottom of the screen, aligned to the grid's right
// edge. During the build-in it holds Skip (shown only while an agent is on screen).
---
<div class="control-bar container" data-control-bar>
  <button type="button" class="bi-skip mono" data-bi-skip hidden>Skip</button>
</div>

<style>
  .control-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: var(--space-4);
    z-index: 20;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }
  .bi-skip {
    pointer-events: auto;
    padding: var(--space-2) var(--space-3);
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }
  .bi-skip:hover { color: var(--accent); }
  .bi-skip[hidden] { display: none; }
</style>
