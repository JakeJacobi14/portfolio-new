---
// Registration marks (DESIGN.md §6): a small + at the top corners of a section's content box,
// centered in the space above it. `bottom` adds the two bottom corners too.
interface Props { bottom?: boolean }
const { bottom = false } = Astro.props;
const corners = bottom ? ["tl", "tr", "bl", "br"] : ["tl", "tr"];
---
{corners.map((c) => <span class={`reg reg-${c}`} aria-hidden="true"></span>)}

<style is:global>
  /* The section needs `position: relative` and its own --reg-offset (space above it / 2). */
  .reg {
    position: absolute;
    width: var(--mark-size);
    height: var(--mark-size);
    pointer-events: none;
    background:
      linear-gradient(var(--line), var(--line)) center / 1px 100% no-repeat,
      linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat;
  }
  .reg-tl, .reg-tr { top: calc(-1 * var(--reg-offset, 0px) - var(--mark-size) / 2); }
  .reg-bl, .reg-br { bottom: calc(-1 * var(--reg-offset, 0px) - var(--mark-size) / 2); }
  .reg-tl, .reg-bl { left: calc(var(--gutter) - var(--mark-size) / 2); }
  .reg-tr, .reg-br { right: calc(var(--gutter) - var(--mark-size) / 2); }
</style>
