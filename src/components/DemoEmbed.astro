---
// A project's live demo, run in place (DESIGN.md §8). On wide screens it loads by itself
// once it comes near the screen and the visitor has first moved, touched or typed, in an
// iframe at the full page width; the screenshot shows until it's ready. Below 960px the demo's own layout doesn't fit, so phones get the
// screenshot and a link instead.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  url: string;
  title: string; // "Physics engine", for the iframe and button
  poster: ImageMetadata;
  posterAlt: string;
}
const { url, title, poster, posterAlt } = Astro.props;
---
<figure class="demo" data-demo data-frame>
  <div class="stage" data-demo-stage data-url={url} data-title={`${title} demo`} style={`--poster: ${poster.width} / ${poster.height}`}>
    <Image src={poster} alt={posterAlt} loading="eager" widths={[640, 1120, 1600]} sizes="(min-width: 1184px) 1056px, calc(100vw - 64px)" />
  </div>
  <figcaption class="mono">
    <span class="wide">live demo, runs here · </span><span class="narrow">the demo needs a wider screen · </span><a href={url} rel="noopener" target="_blank">open in a new tab ↗</a>
  </figcaption>
</figure>

<style>
  .demo { margin: var(--space-6) 0 0; }
  /* Phones: the screenshot in its own shape. Wide screens: 16:10, room for the demo's
     controls; the screenshot fills it until the demo has loaded over it. */
  .stage {
    position: relative;
    aspect-ratio: var(--poster);
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stage :global(img), .stage :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .stage :global(iframe) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease);
  }
  .stage :global(iframe.ready) { opacity: 1; }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  figcaption a { color: inherit; text-decoration-color: color-mix(in srgb, var(--muted) 50%, transparent); }
  figcaption a:hover, figcaption a:focus-visible { color: var(--accent); text-decoration-color: currentColor; }
  .wide { display: none; }
  @media (min-width: 960px) {
    .stage { aspect-ratio: 16 / 10; }
    .stage :global(img) { object-fit: cover; object-position: top; }
    .wide { display: inline; }
    .narrow { display: none; }
  }
</style>

<script>
  const wide = matchMedia("(min-width: 960px)");
  // The demo is a whole second page; it loads once the visitor first moves, touches or types
  // (in practice at once), not during this page's own load, so it never competes with it.
  const INPUTS = ["pointermove", "pointerdown", "wheel", "touchstart", "keydown"] as const;
  const interacted = new Promise<void>((resolve) => {
    const go = () => { for (const t of INPUTS) removeEventListener(t, go); resolve(); };
    for (const t of INPUTS) addEventListener(t, go, { passive: true });
  });
  for (const stage of document.querySelectorAll<HTMLElement>("[data-demo-stage]")) {
    const io = new IntersectionObserver(async (entries) => {
      if (!wide.matches || !entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      await interacted;
      const frame = document.createElement("iframe");
      frame.src = stage.dataset.url!;
      frame.title = stage.dataset.title!;
      frame.allow = "autoplay; fullscreen"; // the demo's own sounds, once it allows them
      frame.addEventListener("load", () => frame.classList.add("ready"), { once: true });
      stage.append(frame);
    }, { rootMargin: "200px 0px" });
    io.observe(stage);
    wide.addEventListener("change", () => { if (wide.matches) { io.unobserve(stage); io.observe(stage); } });
  }
</script>
