<section id="contact" class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="label mono" data-type>Contact</h2>
  <ul>
    <li data-contact><span class="mono key" data-type>Email</span> <span data-type>Placeholder: your address</span></li>
    <li data-contact><span class="mono key" data-type>GitHub</span> <span data-type>Placeholder: your profile</span></li>
    <li data-contact><span class="mono key" data-type>LinkedIn</span> <span data-type>Placeholder: your profile</span></li>
  </ul>
</section>

<style>
  .contact {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-9);
  }
  .label { color: var(--muted); font-weight: 400; margin-bottom: var(--space-4); }
  li { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-1) 0; }
  .key { color: var(--muted); min-width: 9ch; }
</style>
