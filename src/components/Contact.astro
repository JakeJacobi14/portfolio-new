---
import RegMarks from "./RegMarks.astro";
---
<section id="contact" class="contact section container grid" aria-labelledby="contact-title">
  <RegMarks />
  <h2 id="contact-title" class="label mono full" data-type>Contact</h2>
  <ul class="full">
    <li data-contact><span class="mono key" data-type>Email</span> <span data-type>Placeholder: your address</span></li>
    <li data-contact><span class="mono key" data-type>GitHub</span> <span data-type>Placeholder: your profile</span></li>
    <li data-contact><span class="mono key" data-type>LinkedIn</span> <span data-type>Placeholder: your profile</span></li>
  </ul>
</section>

<style>
  ul, li { display: grid; grid-template-columns: subgrid; }
  li { grid-column: 1 / -1; align-items: baseline; padding: var(--space-1) 0; }
  .key { grid-column: 1 / 2; color: var(--muted); }
  .key + span { grid-column: 2 / -1; }
  @media (min-width: 640px) {
    .key { grid-column: 1 / 3; }
    .key + span { grid-column: 3 / -1; }
  }
</style>
