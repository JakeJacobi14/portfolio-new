---
// Behind the page (DESIGN.md §6, ADR 0009): the 12 column guides the agents draw at the
// start of the build-in. Hidden at rest; they fade out completely once the first screen is
// built. Decorative.
const cols = Array.from({ length: 12 });
---
<div class="backdrop" aria-hidden="true">
  <div class="guides container grid" data-guides>
    {cols.map(() => <span class="col" data-guide-col></span>)}
  </div>
</div>

<style is:global>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .guides { position: absolute; inset: 0; opacity: 0; }
  .col { border-inline: 1px solid var(--muted); }
  /* 4 / 8 / 12 columns, matching --cols. */
  .col:nth-child(n + 5) { display: none; }
  @media (min-width: 640px) {
    .col:nth-child(n + 5) { display: block; }
    .col:nth-child(n + 9) { display: none; }
  }
  @media (min-width: 960px) { .col:nth-child(n + 9) { display: block; } }
</style>
