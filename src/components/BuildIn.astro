---
// The signature moment (DESIGN.md §1, §7; ADR 0006, 0014, 0019, 0020). On the home page a
// crew of five agents lays out the hero like a design tool while one of them builds the
// constellation; on a project page, agents lay out its title and facts. Every later section
// gets its own crew once it's settled into view, and finishes in under a second; sections
// scrolled past without stopping appear finished. Agents are made by the script.
---
<div class="bi-overlay" data-bi-overlay aria-hidden="true" hidden></div>
<button type="button" class="bi-skip mono" data-bi-skip hidden>Skip</button>

<style is:global>
  /* Before the script runs: hide whatever the agents will make. */
  .is-building [data-type],
  .is-building [data-frame] { opacity: 0; }
  /* While building: list hairlines are drawn by an agent instead. */
  .is-building [data-row],
  .b-active [data-row]:not([data-built]) { border-color: transparent !important; }

  /* Overlay internals are global because some of them are created by the script. */
  .bi-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  }
  .bi-cursor {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    overflow: visible;
    z-index: 2;
  }
  .bi-cursor path {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .bi-caret {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
  }
  .bi-line {
    position: absolute;
    width: 1px;
    height: 1px;
  }
  .bi-rule { background: color-mix(in srgb, var(--muted) 35%, transparent); }

  /* A text frame, as in a design tool: thin selection rectangle, corner handles, size label. */
  .bi-frame {
    position: absolute;
    border: 1px solid var(--accent);
  }
  .bi-frame i {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .bi-frame i:nth-child(1) { left: -3px; top: -3px; }
  .bi-frame i:nth-child(2) { right: -3px; top: -3px; }
  .bi-frame i:nth-child(3) { left: -3px; bottom: -3px; }
  .bi-frame i:nth-child(4) { right: -3px; bottom: -3px; }
  .bi-size {
    position: absolute;
    left: -1px;
    top: calc(100% + var(--space-1));
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    line-height: 1.3;
    color: var(--accent);
    white-space: nowrap;
  }

  .bi-skip {
    position: fixed;
    right: var(--gutter);
    bottom: var(--space-4);
    z-index: 20;
    padding: var(--space-2) var(--space-3);
    color: var(--muted);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }
  .bi-skip:hover { color: var(--accent); }
  .bi-skip[hidden] { display: none; }
</style>


<script>
  import { animate } from "motion/mini";

  const EASE: [number, number, number, number] = [0.2, 0, 0, 1]; // --ease
  const MS_PER_CHAR = { display: 45, quick: 12 }; // the hero's name; titles in later sections (DESIGN.md §7)
  const FRAME_PAD = 3; // px between a text frame and its text
  const QUICK = { grow: 0.35, rise: 0.25 }; // s, frames in later sections
  const SHOWN = 0.3, DWELL = 120; // a section starts once 30% of it is in view, for 120ms,
  const SETTLED = 1200; // px/s: counted only while scrolling slower than this (i.e. stopping)
  const CURSOR = '<path d="M1 1 L1 16 L5 12.5 L8 19 L10.5 18 L7.6 11.6 L12.5 11.6 Z" />';
  const NS = "http://www.w3.org/2000/svg";

  type Box = { x: number; y: number; w: number; h: number };
  type Anim = { cancel(): void };
  class Aborted extends Error {}

  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>("[data-bi-overlay]")!;
  const skipBtn = document.querySelector<HTMLButtonElement>("[data-bi-skip]")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  const q = <T extends Element = HTMLElement>(s: string, from: ParentNode = document) => from.querySelector<T>(s);
  const qa = <T extends Element = HTMLElement>(s: string, from: ParentNode = document) => [...from.querySelectorAll<T>(s)];
  /** Page (document) coordinates, so the overlay stays aligned while the page scrolls. */
  const box = (el: Element): Box => {
    const r = el.getBoundingClientRect();
    return { x: r.left + scrollX, y: r.top + scrollY, w: r.width, h: r.height };
  };
  /** Where an element's text actually is, for a block that's wider than its words. */
  const textBox = (el: Element): Box => {
    const range = document.createRange();
    range.selectNodeContents(el);
    const r = range.getBoundingClientRect();
    return r.width ? { x: r.left + scrollX, y: r.top + scrollY, w: r.width, h: r.height } : box(el);
  };

  /** cubic-bezier(x1, y1, x2, y2) as a function of progress, for motion driven frame by frame. */
  const bezier = (x1: number, y1: number, x2: number, y2: number) => (x: number) => {
    let lo = 0, hi = 1, t = x;
    for (let i = 0; i < 24; i++) {
      t = (lo + hi) / 2;
      const bx = 3 * (1 - t) ** 2 * t * x1 + 3 * (1 - t) * t ** 2 * x2 + t ** 3;
      if (bx < x) lo = t; else hi = t;
    }
    return 3 * (1 - t) ** 2 * t * y1 + 3 * (1 - t) * t ** 2 * y2 + t ** 3;
  };
  const ease = bezier(...EASE);
  /** The time (0..1) at which an eased motion reaches progress p. */
  const easeInverse = (p: number) => {
    let lo = 0, hi = 1;
    for (let i = 0; i < 24; i++) { const m = (lo + hi) / 2; if (ease(m) < p) lo = m; else hi = m; }
    return (lo + hi) / 2;
  };

  /** One build of the page: what's been taken apart, and the crews putting it back. */
  class Director {
    aborted = false;
    typed = new Map<HTMLElement, string>();
    markup = new Map<HTMLElement, string>(); // typed elements' original HTML (links, lang spans)
    agents = new Set<Agent>();
    crews = new Set<Crew>();
    units: Unit[] = [];
    cleanup: (() => void)[] = [];
    updateSkip() { skipBtn.hidden = ![...this.agents].some((a) => a.present); }
    /** Put a typed element's own HTML back at once. */
    restore(el: HTMLElement | null) {
      if (!el) return;
      const text = this.typed.get(el);
      if (text === undefined) return;
      el.innerHTML = this.markup.get(el) ?? text;
      this.typed.delete(el);
    }
  }

  /** The agents and everything in flight for one part of the page (the hero, a work row, a
      section), so that part can be finished on its own, or stopped and finished instantly. */
  class Crew {
    aborted = false;
    live = new Set<Anim>();
    pieces: Element[] = []; // overlay lines and frames
    trailing = new Set<Promise<unknown>>(); // fades nobody waits on
    agents: Agent[] = [];
    constructor(public d: Director) { d.crews.add(this); }
    get stopped() { return this.aborted || this.d.aborted; }
    check() { if (this.stopped) throw new Aborted(); }
    wait(ms: number) { return new Promise((r) => setTimeout(r, ms)).then(() => this.check()); }
    async play(el: Element, keyframes: Record<string, unknown>, opts: Record<string, unknown> = {}) {
      this.check();
      const a = animate(el, keyframes as any, { ease: EASE, ...opts });
      this.live.add(a);
      try { await a; } finally { this.live.delete(a); }
      this.check();
    }
    /** Run a step every frame for `dur` seconds, with progress 0..1. */
    tween(dur: number, step: (p: number) => void) {
      this.check();
      return new Promise<void>((resolve, reject) => {
        const t0 = performance.now();
        const frame = (now: number) => {
          if (this.stopped) return reject(new Aborted());
          const p = Math.min(1, (now - t0) / 1000 / dur);
          step(p);
          if (p < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });
    }
    /** Start an animation without waiting for it (it's still stopped with the crew). */
    later(p: Promise<unknown>) {
      const q = p.catch(() => {});
      this.trailing.add(q);
      q.then(() => this.trailing.delete(q));
    }
    /** Fade an element in with a 4px rise (typed elements get their own HTML back first). */
    async reveal(el: HTMLElement | null, delayMs = 0) {
      if (!el) return;
      this.d.restore(el);
      el.style.opacity = "0";
      if (delayMs) await this.wait(delayMs);
      el.style.opacity = "";
      await this.play(el, { opacity: [0, 1], transform: ["translateY(4px)", "none"] }, { duration: 0.3 });
    }
    spawn(x: number, y: number, quick = true) {
      const a = new Agent(this, quick);
      this.agents.push(a);
      a.enter(x, y);
      return a;
    }
    /** Stop: cancel what's in flight and take the agents and overlay pieces away. */
    halt() {
      this.aborted = true;
      for (const a of this.live) { try { a.cancel(); } catch {} }
      this.live.clear();
      for (const p of this.pieces) p.remove();
      for (const a of this.agents) a.remove();
      this.d.crews.delete(this);
    }
    /** A normal end: the last frames fade, then the agents step away. */
    async wrapUp() {
      await Promise.all(this.trailing);
      await Promise.all(this.agents.map((a) => a.leave()));
      for (const p of this.pieces) p.remove();
      this.d.crews.delete(this);
    }
  }

  class Agent {
    x = 0;
    y = 0;
    present = false;
    private el: SVGSVGElement;
    private caret: HTMLElement;
    constructor(private c: Crew, private quick: boolean) {
      this.el = document.createElementNS(NS, "svg");
      this.el.setAttribute("class", "bi-cursor");
      this.el.setAttribute("viewBox", "0 0 14 20");
      this.el.setAttribute("width", "14");
      this.el.setAttribute("height", "20");
      this.el.innerHTML = CURSOR;
      this.caret = document.createElement("span");
      this.caret.className = "bi-caret";
      overlay.append(this.caret, this.el);
      c.d.agents.add(this);
    }

    private travel(dist: number) {
      return this.quick ? Math.min(0.2, Math.max(0.1, dist / 3000)) : Math.min(0.7, Math.max(0.3, dist / 1600));
    }
    place(x: number, y: number) {
      this.x = x; this.y = y;
      this.el.style.transform = `translate(${x}px, ${y}px)`;
    }
    enter(x: number, y: number) {
      this.place(x, y);
      this.el.style.opacity = "1";
      this.c.later(this.c.play(this.el, { opacity: [0, 1] }, { duration: this.quick ? 0.12 : 0.2 }));
      this.present = true;
      this.c.d.updateSkip();
    }
    async move(x: number, y: number, duration = this.travel(Math.hypot(x - this.x, y - this.y))) {
      if (Math.hypot(x - this.x, y - this.y) < 1) return this.c.check(); // already there
      const from = `translate(${this.x}px, ${this.y}px)`;
      this.place(x, y);
      await this.c.play(this.el, { transform: [from, this.el.style.transform] }, { duration });
    }
    async leave() {
      if (!this.present) return this.remove();
      try {
        const a = animate(this.el, { opacity: [1, 0], transform: [this.el.style.transform, `translate(${this.x + 12}px, ${this.y + 16}px)`] } as any, { ease: EASE, duration: 0.25 });
        this.c.live.add(a);
        await a;
      } catch {}
      this.remove();
    }
    remove() {
      this.el.remove();
      this.caret.remove();
      this.present = false;
      this.c.d.agents.delete(this);
      this.c.d.updateSkip();
    }

    /** Type an element's text one character at a time behind a caret. The cursor follows
        the caret, unless it's holding a frame (then only the caret moves). */
    async type(el: HTMLElement | null, msPerChar: number, follow = true) {
      if (!el) return;
      const text = this.c.d.typed.get(el);
      const spans = [...el.children] as HTMLElement[];
      if (text === undefined || !spans.length) return;
      if (follow) {
        const first = box(spans[0]);
        await this.move(first.x, first.y + first.h + 2);
      }
      const c = this.caret;
      c.style.opacity = "1";
      for (let i = 0; i < spans.length; i++) {
        spans[i].style.opacity = "";
        const r = box(spans[i]);
        c.style.height = `${r.h}px`;
        c.style.transform = `translate(${r.x + r.w}px, ${r.y}px)`;
        // The cursor drifts along with the caret, a word at a time.
        if (follow && (text[i] === " " || i === spans.length - 1)) {
          this.move(r.x + r.w, r.y + r.h + 2, this.quick ? 0.12 : 0.25).catch(() => {});
        }
        await this.c.wait(msPerChar * (0.6 + Math.random() * 0.8));
      }
      c.style.opacity = "0";
      this.c.d.restore(el);
    }

    /** Lay out an element like a design tool (ADR 0014): drag out a frame from its top-left
        corner to full size, with a size label that fades, then set the content in (typed
        behind a caret, or a short fade and rise). The frame fades once the content lands.
        `fit` frames the text rather than the element's box; `ms` is the typing pace. */
    async frame(el: HTMLElement | null, set: "type" | "rise" | "outline", t = { grow: 0.45, rise: 0.3 }, o: { fit?: boolean; ms?: number } = {}) {
      if (!el) return;
      const b = o.fit ? textBox(el) : box(el);
      if (b.w === 0) { el.style.opacity = ""; return; } // not displayed: nothing to lay out
      const x = b.x - FRAME_PAD, y = b.y - FRAME_PAD;
      const w = b.w + 2 * FRAME_PAD, h = b.h + 2 * FRAME_PAD;
      await this.move(x, y);
      const f = document.createElement("div");
      f.className = "bi-frame";
      f.innerHTML = "<i></i><i></i><i></i><i></i><span class='bi-size'></span>";
      f.style.left = `${x}px`;
      f.style.top = `${y}px`;
      overlay.append(f);
      this.c.pieces.push(f);
      const size = f.querySelector<HTMLElement>(".bi-size")!;
      const w0 = Math.min(w, 16), h0 = Math.min(h, 10);
      await this.c.tween(t.grow, (p) => {
        const e = ease(p);
        const fw = w0 + (w - w0) * e, fh = h0 + (h - h0) * e;
        f.style.width = `${fw}px`;
        f.style.height = `${fh}px`;
        this.place(x + fw, y + fh);
        size.textContent = `W ${Math.round(fw - 2 * FRAME_PAD)} · H ${Math.round(fh - 2 * FRAME_PAD)}`;
      });
      this.c.later(this.c.play(size, { opacity: [1, 0] }, { duration: 0.4, delay: 0.1 }));
      // "outline": the content is already there (it arrived with a view transition).
      if (set !== "outline") {
        if (set === "rise") this.c.d.restore(el); // a typed element rises in whole
        el.style.opacity = "1";
        if (set === "type") await this.type(el, o.ms ?? MS_PER_CHAR.display, false);
        else await this.c.play(el, { opacity: [0, 1], transform: ["translateY(4px)", "none"] }, { duration: t.rise });
      }
      el.style.opacity = "";
      this.c.later(this.c.play(f, { opacity: [1, 0] }, { duration: 0.3 }).then(() => f.remove()));
    }

    /** Draw a 1px horizontal line from one point to another, cursor moving along. */
    async draw(x1: number, x2: number, y: number, dur: number) {
      const line = rule(this.c, x1, x2, y);
      await this.move(x1, y);
      await Promise.all([
        this.c.play(line, { transform: ["scaleX(0)", "scaleX(1)"] }, { duration: dur }),
        this.move(x2, y, dur),
      ]);
    }
  }

  /** A hairline in the overlay, ready to grow from x1 toward x2 (it's removed with the crew). */
  function rule(c: Crew, x1: number, x2: number, y: number) {
    const line = document.createElement("span");
    line.className = "bi-line bi-rule";
    line.style.left = `${Math.min(x1, x2)}px`;
    line.style.top = `${y}px`;
    line.style.width = `${Math.abs(x2 - x1)}px`;
    line.style.transformOrigin = x2 >= x1 ? "left" : "right";
    overlay.append(line);
    c.pieces.push(line);
    return line;
  }

  const SKY = "[data-c-node], [data-c-label-for], [data-c-dust], [data-c-fig]";
  const within = (roots: Element[], sel: string) =>
    roots.flatMap((r) => [...(r.matches(sel) ? [r] : []), ...qa(sel, r)]) as (HTMLElement & SVGElement)[];

  /** Measure the finished layout, then put every element in its "not made yet" state. */
  function prepare(d: Director) {
    root.classList.add("b-active");
    for (const el of qa("[data-type]")) {
      const text = (el.textContent ?? "").replace(/\s+/g, " ").trim();
      d.markup.set(el, el.innerHTML);
      el.textContent = "";
      for (const ch of text) {
        const s = document.createElement("span");
        s.textContent = ch;
        // Transparent rather than hidden: the text stays readable by screen readers (and
        // gives links their names) while it waits to be typed.
        s.style.opacity = "0";
        el.append(s);
      }
      d.typed.set(el, text);
    }
    for (const el of qa("[data-frame]")) el.style.opacity = "0";
    for (const el of qa("[data-made]")) el.removeAttribute("data-made");
    for (const el of qa("[data-row]")) delete el.dataset.built;
    // The constellation's stars, stardust, figures and labels are placed by an agent.
    for (const el of qa<HTMLElement>(SKY)) el.style.opacity = "0";
    root.classList.remove("is-building");
    overlay.style.height = `${root.scrollHeight}px`;
    overlay.hidden = false;
  }

  /** Put part of the page (or all of it) in its finished state at once. */
  function settle(d: Director, roots: Element[]) {
    for (const el of [...d.typed.keys()]) if (roots.some((r) => r.contains(el))) d.restore(el);
    for (const el of within(roots, "[data-frame]")) { el.style.opacity = ""; el.style.transform = ""; }
    for (const el of within(roots, "[data-row]")) { el.dataset.built = ""; clearNudge(el); }
    for (const el of within(roots, SKY)) { el.style.opacity = ""; el.style.transform = ""; }
    for (const l of within(roots, "[data-c-line]")) { l.style.strokeDasharray = ""; l.style.strokeDashoffset = ""; }
    for (const fx of within(roots, "[data-c-fx]")) fx.replaceChildren();
  }

  /** A work row's arrow is nudged in with inline styles; hand it back to the stylesheet. */
  const clearNudge = (row: Element) => {
    const arrow = q(".arrow", row);
    if (arrow) { arrow.style.opacity = ""; arrow.style.transform = ""; }
  };

  let current: Director | null = null;

  function finish() {
    const d = current;
    if (d) {
      d.aborted = true;
      for (const stop of d.cleanup) stop();
      for (const c of [...d.crews]) c.halt();
      for (const a of [...d.agents]) a.remove();
      settle(d, [document.body]);
    }
    for (const el of qa("[data-frame]")) { el.style.opacity = ""; el.style.transform = ""; }
    for (const el of qa("[data-row]")) delete el.dataset.built;
    overlay.replaceChildren();
    overlay.hidden = true;
    skipBtn.hidden = true;
    root.classList.remove("is-building", "b-active", "hero-building");
    if (d) for (const u of d.units) u.el.setAttribute("data-made", "");
    current = null;
  }

  /** The commit constellation (DESIGN.md §8, ADR 0011). The agent sweeps outward from the
      center on a smooth spiral; stars ripple in as it passes (a quick scale-up, and a
      faint ping ring on the ones it places itself), with a short fading trail. Stardust
      fades in ring by ring behind it, and the constellation lines draw last. About 2s. */
  async function placeNodes(c: Crew, a: Agent, figure: HTMLElement) {
    const nodes = qa<SVGAElement>("[data-c-node]", figure);
    const svg = q<SVGSVGElement>(".c-sky svg", figure);
    const fx = q<SVGGElement>("[data-c-fx]", figure);
    if (!nodes.length || !svg || !fx) return;
    const SWEEP = 1.7, RIPPLE = 0.004, TRAIL = 0.2, TRAIL_MAX = 8, TURNS = 1.75; // s, s/unit, s, units, turns
    const sb = svg.getBoundingClientRect();
    const vb = svg.viewBox.baseVal;
    const toPage = (x: number, y: number) => [
      sb.left + scrollX + ((x - vb.x) / vb.width) * sb.width,
      sb.top + scrollY + ((y - vb.y) / vb.height) * sb.height,
    ] as const;
    const stars = nodes.map((el) => {
      const x = Number(el.dataset.x), y = Number(el.dataset.y);
      return { el, x, y, r: Number(el.dataset.r), dist: Math.hypot(x - 50, y - 50), placed: !!q(".c-halo", el), at: 0 };
    });
    const R = Math.max(...stars.map((st) => st.dist)) + 1;
    const last = stars[stars.length - 1];
    const a0 = Math.atan2(last.y - 50, last.x - 50) - TURNS * 2 * Math.PI; // ends on the newest
    const spiral = (p: number) => {
      const ang = a0 + p * TURNS * 2 * Math.PI;
      return [50 + R * p * Math.cos(ang), 50 + R * p * Math.sin(ang)] as const;
    };
    // Each star appears when the sweep reaches its distance from the center, a little
    // later the farther it is from the cursor at that moment (the ripple).
    for (const st of stars) {
      const p = Math.min(1, st.dist / R);
      const [cx, cy] = spiral(p);
      st.at = easeInverse(p) * SWEEP + Math.hypot(st.x - cx, st.y - cy) * RIPPLE;
    }
    // The agent places a few itself: the bright ones, plus any it passes right over.
    let extra = 0;
    for (const st of stars) {
      if (st.placed) continue;
      const [cx, cy] = spiral(Math.min(1, st.dist / R));
      if (Math.hypot(st.x - cx, st.y - cy) < 3 && extra < 12) { st.placed = true; extra++; }
    }
    const pending = [...stars].sort((p, q) => p.at - q.at);
    const dustBands = qa<SVGGElement>("[data-c-dust]", figure).map((g) => {
      // The band's outer edge (6 rings out to radius 46, see lib/constellation.ts).
      const outer = Math.min(1, (((Number(g.dataset.cDust) + 1) / 6) * 46) / R);
      return { g, at: easeInverse(outer) * SWEEP + 0.15 };
    });
    const end = Math.max(SWEEP, ...stars.map((st) => st.at)) + 0.15;

    const [sx, sy] = toPage(...spiral(0));
    await a.move(sx, sy);
    const trail = document.createElementNS(NS, "path");
    trail.setAttribute("class", "c-trail");
    fx.append(trail);
    const history: [number, number, number][] = [];
    const appearing: Promise<unknown>[] = [];
    const dusting: Promise<unknown>[] = []; // not waited on: lines start while dust fades in
    const shown = new Set<(typeof dustBands)[number]>();
    const ping = (st: (typeof stars)[number]) => {
      const ring = document.createElementNS(NS, "circle");
      ring.setAttribute("class", "c-ping");
      ring.setAttribute("cx", String(st.x));
      ring.setAttribute("cy", String(st.y));
      ring.setAttribute("r", String(st.r + 2.2));
      ring.style.transformBox = "fill-box";
      ring.style.transformOrigin = "center";
      ring.setAttribute("vector-effect", "non-scaling-stroke");
      fx.append(ring);
      appearing.push(c.play(ring, { opacity: [0.5, 0], transform: ["scale(0.3)", "scale(1)"] }, { duration: 0.3 })
        .finally(() => ring.remove()));
    };

    const t0 = performance.now();
    await new Promise<void>((resolve, reject) => {
      const frame = (now: number) => {
        if (c.stopped) return reject(new Aborted());
        const t = (now - t0) / 1000;
        const [x, y] = spiral(ease(Math.min(1, t / SWEEP)));
        const [px, py] = toPage(x, y);
        a.place(px, py);
        history.push([t, x, y]);
        while (history.length && history[0][0] < t - TRAIL) history.shift();
        // Keep the trail short even where the cursor moves fast.
        let length = 0;
        for (let k = history.length - 1; k > 0; k--) {
          length += Math.hypot(history[k][1] - history[k - 1][1], history[k][2] - history[k - 1][2]);
          if (length > TRAIL_MAX) { history.splice(0, k); break; }
        }
        trail.setAttribute("d", history.map(([, hx, hy], i) => `${i ? "L" : "M"}${hx} ${hy}`).join(""));
        while (pending.length && pending[0].at <= t) {
          const st = pending.shift()!;
          appearing.push(c.play(st.el, { opacity: [0, 1], transform: ["scale(0.3)", "scale(1.25)", "scale(1)"] }, { duration: 0.3 }));
          if (st.placed) ping(st);
        }
        for (const b of dustBands) {
          if (b.at <= t && !shown.has(b)) {
            shown.add(b);
            dusting.push(c.play(b.g, { opacity: [0, 1] }, { duration: 0.5 }));
          }
        }
        // The sweep stops at SWEEP and end is later than SWEEP + TRAIL, so the trail has
        // already shrunk to nothing by the time the loop ends.
        if (t < end) requestAnimationFrame(frame);
        else resolve();
      };
      requestAnimationFrame(frame);
    });
    trail.remove();
    // The last stars are still settling; the lines start now and they're tidied up after.
    const placing = Promise.all(appearing);
    placing.catch(() => {});
    Promise.all(dusting).then(() => { for (const b of dustBands) b.g.style.opacity = ""; }, () => {});

    // Constellation lines last: the agent visits each milestone and its figure draws out
    // from it. About 1.2s in all, however many milestones there are.
    const figs = qa<SVGGElement>("[data-c-fig]", figure);
    const each = Math.min(0.5, 1.2 / Math.max(1, figs.length));
    for (const g of figs) {
      g.style.opacity = "";
      const lines = qa<SVGLineElement>("[data-c-line]", g);
      for (const l of lines) { l.style.strokeDasharray = "1"; l.style.strokeDashoffset = "1"; }
      const star = q<SVGAElement>(`[data-c-node][data-tags][data-fig="${g.dataset.cFig}"]`, figure);
      if (star) { const b = box(star); await a.move(b.x + b.w / 2, b.y + b.h / 2, Math.max(0.2, each * 0.6)); }
      const label = q<HTMLElement>(`[data-c-label-for="${g.dataset.cFig}"]`, figure);
      await Promise.all([
        ...lines.map((l) => c.play(l, { strokeDashoffset: ["1", "0"] }, { duration: each })),
        label ? c.play(label, { opacity: [0, 1] }, { duration: each }) : null,
      ]);
    }
    for (const el of qa<HTMLElement>("[data-c-label-for]", figure)) el.style.opacity = "";
    for (const l of qa<SVGLineElement>("[data-c-line]", figure)) { l.style.strokeDasharray = ""; l.style.strokeDashoffset = ""; }
    await placing;
    for (const st of stars) { st.el.style.opacity = ""; st.el.style.transform = ""; }
  }

  /** A part of the page that builds itself: when it's triggered, what it covers, how. */
  type Unit = {
    el: Element; // starts when this enters the screen
    roots: Element[]; // what it builds (and finishes, if it has to finish instantly)
    run: (c: Crew) => Promise<void>;
    state: "waiting" | "running" | "done";
    seen?: number; // when it last came 30% into view
    after?: Unit; // doesn't start before this one is done
    crew?: Crew;
    onDone?: () => void;
  };

  async function build() {
    if (current) return;
    if (reduce.matches) return finish();
    const d = new Director();
    current = d;
    // The sky's ambient details (ADR 0016) wait while the hero is being built.
    root.classList.add("hero-building");
    clearTimeout((window as any).__buildFailsafe);
    // Positions depend on web fonts; don't wait longer than 600ms for them.
    await Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 600))]);
    // After a view transition (a project title morphing in), start once it has finished.
    // Browsers without page-reveal events don't wait.
    const revealed = (window as any).__revealed as Promise<void> | undefined;
    if (revealed) await Promise.race([revealed, new Promise((r) => setTimeout(r, root.classList.contains("vt-in") ? 1500 : 150))]);
    if (d.aborted) return;
    const page = document.body.dataset.build === "work" ? "work" : "home";
    if (page === "work") {
      // A project page's body is Markdown: its section headings are typed and the rest of
      // each section fades in (hidden before the script by a rule on the page).
      for (const h of qa(".body > h2")) h.setAttribute("data-type", "");
      for (const el of qa(".body > :not(h2)")) el.setAttribute("data-frame", "");
    }
    prepare(d);

    const vh = innerHeight, top = scrollY;
    const units = d.units;
    const unit = (el: Element | null, roots: (Element | null)[], run: Unit["run"], onDone?: () => void, after?: Unit) => {
      if (el) units.push({ el, roots: roots.filter((r): r is Element => !!r), run, state: "waiting", onDone, after });
    };
    // Later sections (ADR 0019): titles are typed quickly; longer text fades in.
    const quickType = (c: Crew, el: HTMLElement | null) => {
      const first = el?.firstElementChild;
      if (!el || !first) return Promise.resolve();
      const b = box(first);
      return c.spawn(b.x, b.y + b.h + 2).type(el, MS_PER_CHAR.quick);
    };
    const quickFrame = (c: Crew, el: HTMLElement | null, delayMs = 0) => {
      if (!el) return Promise.resolve();
      const b = box(el);
      if (b.w === 0) { el.style.opacity = ""; return Promise.resolve(); }
      return c.wait(delayMs).then(() => c.spawn(b.x - FRAME_PAD, b.y - FRAME_PAD).frame(el, "rise", QUICK));
    };
    const footer = q("[data-footer]");

    if (page === "work") {
      // ---- A project page (ADR 0020): about 1.5s for its head ----
      // The title is laid out with a frame (only outlined if it just morphed in from the home
      // page), then the facts and links; each section builds as it comes into view.
      const head = q("[data-work-head]")!;
      const title = q("[data-work-title]", head);
      const arrived = root.classList.contains("vt-in");
      unit(head, [q("header"), head], async (c) => {
        await Promise.all([
          c.reveal(q("header .home")),
          c.reveal(q("header nav")),
          c.reveal(q("[data-back]", head)),
          (async () => {
            if (title) {
              const b = box(title);
              await c.spawn(b.x - FRAME_PAD, b.y - FRAME_PAD).frame(title, arrived ? "outline" : "rise", QUICK);
            }
            await Promise.all([
              c.reveal(q("[data-summary]", head)),
              quickFrame(c, q("[data-facts]", head), 60),
              c.reveal(q("[data-links]", head), 150),
              quickFrame(c, q("[data-cover], [data-model]", head), 220),
            ]);
          })(),
        ]);
      }, () => root.classList.remove("hero-building"));
      // Sections (and the footer) wait for the head, then build as they come into view.
      const headUnit = units[0];
      for (const h of qa(".body > h2")) {
        const parts: HTMLElement[] = [];
        for (let n = h.nextElementSibling; n && n.tagName !== "H2"; n = n.nextElementSibling) parts.push(n as HTMLElement);
        unit(h, [h, ...parts], async (c) => {
          await Promise.all([quickType(c, h), ...parts.map((p, i) => c.reveal(p, 80 + i * 60))]);
        }, undefined, headUnit);
      }
      const demo = q("[data-demo]");
      unit(demo, [demo], (c) => quickFrame(c, demo), undefined, headUnit);
      unit(footer, [footer], (c) => quickFrame(c, q("p", footer!)), undefined, headUnit);
    } else {
      const figure = q("[data-constellation]")!;
      const caption = q("figcaption", figure);
      const skyNow = box(figure).y < top + vh;

      // ---- The hero (ADR 0014): a crew of five working in parallel, about 2.5s in all ----
      // Each agent appears near its first job; the starts are staggered slightly so it reads
      // as a crew rather than everything at once.
      const intro = q("[data-hero]")!;
      const greeting = q(".greeting", intro), name = q("#intro-title"), tagline = q(".tagline", intro);
      const home = q("header .home"), nav = q("header nav");
      unit(intro, [q("header"), q(".text", intro), skyNow ? figure : null], async (c) => {
        const near = (el: Element | null, dx: number, dy: number) => {
          const b = el ? box(el) : { x: innerWidth / 2, y: top + vh / 2 };
          return c.spawn(b.x + dx, b.y + dy, false);
        };
        await Promise.all([
          // Sky: the constellation, untouched (ADR 0011); it starts on the center, no walk-in.
          (async () => {
            if (!skyNow) return;
            const svg = box(q(".c-sky svg", figure)!);
            await placeNodes(c, c.spawn(svg.x + svg.w / 2, svg.y + svg.h / 2, false), figure);
          })(),
          // The small lines around the name.
          (async () => {
            const a = near(greeting, -48, -24);
            await a.frame(greeting, "rise");
            await a.frame(tagline, "rise");
          })(),
          // The name: frame, then typed in.
          (async () => {
            await c.wait(150);
            await near(name, -40, 40).frame(name, "type");
          })(),
          // The header: the home link, then the nav.
          (async () => {
            await c.wait(80);
            const a = near(home, 40, 40);
            await a.frame(home, "rise");
            await a.frame(nav, "rise");
          })(),
          // The sky's caption.
          (async () => {
            if (!skyNow) return;
            await c.wait(450);
            await near(caption, 40, 32).frame(caption, "rise");
          })(),
        ]);
      }, () => root.classList.remove("hero-building"));

      // ---- Later sections (ADR 0019): each gets its own crew once it's settled into view,
      // and is done in under a second. ----

      // The constellation, if it starts below the first screen (short screens). It keeps its
      // own timing (ADR 0011), the one exception to the one-second budget.
      if (!skyNow) {
        unit(figure, [figure], async (c) => {
          const svg = box(q(".c-sky svg", figure)!);
          await placeNodes(c, c.spawn(svg.x + svg.w / 2, svg.y + svg.h / 2, false), figure);
          await quickFrame(c, caption);
        });
      }

      const workLabel = q("#work-title");
      unit(workLabel, [workLabel], (c) => quickType(c, workLabel));
      const rows = qa("[data-row]");
      let rowCue = -Infinity; // rows that arrive together build in a cascade, 90ms apart
      for (const row of rows) {
        // A crew of two, about 1s. One agent draws the hairline right to left, so it ends
        // where the title starts, drags a frame around the title and types it in; the
        // summary fades in under it. The other frames the year, then nudges the arrow in.
        unit(row, [row], async (c) => {
          const now = performance.now();
          const delay = Math.max(0, rowCue + 90 - now);
          rowCue = now + delay;
          if (delay) await c.wait(delay);
          const b = box(row);
          const title = q("h3", row), meta = q(".meta", row), arrow = q(".arrow", row);
          if (row === rows[rows.length - 1]) {
            const bottom = rule(c, b.x, b.x + b.w, b.y + b.h - 1);
            c.later(c.play(bottom, { transform: ["scaleX(0)", "scaleX(1)"] }, { duration: 0.25 }));
          }
          await Promise.all([
            (async () => {
              const a = c.spawn(b.x + b.w, b.y);
              await a.draw(b.x + b.w, b.x, b.y, 0.25);
              c.later(c.reveal(q(".blurb", row), 350));
              await a.frame(title, "type", QUICK, { fit: true, ms: MS_PER_CHAR.quick });
            })(),
            (async () => {
              if (!meta || box(meta).w === 0) return;
              const m = box(meta);
              await c.wait(120);
              const a = c.spawn(m.x + m.w + 24, b.y + 8);
              await a.frame(meta, "rise", QUICK);
              if (!arrow || box(arrow).w === 0) return;
              const r = box(arrow);
              await a.move(r.x + r.w / 2, r.y + r.h);
              arrow.style.opacity = "1";
              await c.play(arrow, { opacity: [0, 1], transform: ["translateX(-4px)", "none"] }, { duration: QUICK.rise });
            })(),
          ]);
          clearNudge(row);
          row.dataset.built = "";
        });
      }

      // After hours: the label typed and the counter faded in; then, as the strip comes in,
      // a frame per card in view (one agent each, 30ms apart). Cards out of view just appear.
      const head = q("[data-hours-head]");
      unit(head, [head], async (c) => {
        await Promise.all([quickType(c, q("#after-title")), c.reveal(q("[data-count]"), 80)]);
      });
      const strip = q("[data-strip]");
      unit(strip, [strip], async (c) => {
        const s = box(strip!);
        const cards = qa("[data-card]", strip!);
        const seen = cards.filter((card) => { const b = box(card); return b.w > 0 && b.x + b.w > s.x && b.x < s.x + s.w; });
        for (const card of cards) if (!seen.includes(card)) card.style.opacity = "";
        await Promise.all(seen.map((card, i) => quickFrame(c, card, i * 30)));
      });

      const contact = q("#contact");
      unit(contact, [contact], async (c) => {
        await Promise.all([
          quickType(c, q("#contact-title")),
          quickType(c, q("[data-addr]")),
          (async () => {
            await quickFrame(c, q("[data-copy]"), 80);
          })(),
          c.reveal(q("[data-links]"), 250),
        ]);
      });

      unit(footer, [footer], async (c) => {
        await Promise.all([quickFrame(c, q("p", footer!)), quickFrame(c, q("[data-replay]"), 80)]);
      });
    }

    // ---- Running the units ----
    const finished = () => {
      if (units.every((u) => u.state === "done")) finish();
    };
    const complete = (u: Unit, instant: boolean) => {
      if (u.state === "done") return;
      if (instant) u.crew?.halt();
      settle(d, u.roots);
      u.el.removeAttribute("data-building");
      u.el.setAttribute("data-made", "");
      u.state = "done";
      u.onDone?.();
      finished();
      if (!d.aborted) setTimeout(check); // units waiting on this one may start now
    };
    const start = (u: Unit) => {
      u.state = "running";
      u.el.setAttribute("data-building", "");
      const c = (u.crew = new Crew(d));
      // A section is done when its content has landed; its frames fade and its agents step
      // away after that.
      u.run(c)
        .then(() => { complete(u, false); return c.wrapUp(); })
        .catch((e) => {
          if (e instanceof Aborted) return;
          complete(u, true);
          throw e;
        });
    };
    let timer = 0, lastY = scrollY, lastT = performance.now();
    /** A section starts once at least 30% of it (or of the screen, for a tall one) has been in
        view for 120ms with the page (nearly) still, so a fast scroll doesn't set off everything
        it passes. Sections scrolled past without stopping, and any still building when
        scrolled past, appear finished at once. */
    const check = () => {
      if (d.aborted) return;
      const now = performance.now(), vh = innerHeight;
      const moving = now > lastT && (Math.abs(scrollY - lastY) / (now - lastT)) * 1000 > SETTLED;
      lastY = scrollY; lastT = now;
      let next = Infinity;
      for (const u of units) {
        if (u.state === "done") continue;
        const r = u.el.getBoundingClientRect();
        if (r.bottom <= 0) { complete(u, true); continue; }
        if (u.state !== "waiting") continue;
        const visible = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
        if (visible < Math.min(r.height, vh) * SHOWN) { u.seen = undefined; continue; }
        if (moving) { u.seen = undefined; next = Math.min(next, DWELL); continue; } // look again once it stops
        u.seen ??= now;
        if (u.after && u.after.state !== "done") continue;
        if (now - u.seen >= DWELL) start(u);
        else next = Math.min(next, u.seen + DWELL - now);
      }
      clearTimeout(timer);
      if (next < Infinity) timer = window.setTimeout(check, next + 5);
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; check(); });
    };
    addEventListener("scroll", onScroll, { passive: true });
    d.cleanup.push(() => { removeEventListener("scroll", onScroll); clearTimeout(timer); });
    start(units[0]); // the hero (or a project page's head) starts right away
    check();
  }

  if (root.classList.contains("is-building")) build();

  skipBtn.addEventListener("click", finish);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && current) finish(); });
  let lastWidth = innerWidth;
  addEventListener("resize", () => {
    // Positions were measured once; a real width change means they are stale.
    if (innerWidth !== lastWidth) { lastWidth = innerWidth; if (current) finish(); }
  });
  document.querySelector("[data-replay]")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "instant" });
    build();
  });
</script>
