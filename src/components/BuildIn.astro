---
// The signature moment (DESIGN.md §1, §7, ADR 0006, ADR 0007, ADR 0014): five agents make
// the page. On load they lay out the hero like a design tool (a text frame per element, then
// the text sets in) while one of them builds the constellation; later sections are built as
// they scroll into view, by typing the text, drawing the lines and dragging the boxes.
const agents = [0, 1, 2, 3, 4];
---
<div class="bi-overlay" data-bi-overlay aria-hidden="true" hidden>
  {agents.map(() => <span class="bi-caret" data-bi-caret></span>)}
  {agents.map(() => (
    <svg class="bi-cursor" data-bi-cursor viewBox="0 0 14 20" width="14" height="20" focusable="false">
      <path d="M1 1 L1 16 L5 12.5 L8 19 L10.5 18 L7.6 11.6 L12.5 11.6 Z" />
    </svg>
  ))}
</div>
<button type="button" class="bi-skip mono" data-bi-skip hidden>Skip</button>

<style is:global>
  /* Before the script runs: hide whatever the agents will make. */
  .is-building [data-type],
  .is-building [data-drag],
  .is-building [data-frame] { opacity: 0; }
  /* While building: list hairlines are drawn by an agent instead. */
  .is-building [data-row],
  .b-active [data-row]:not([data-built]) { border-color: transparent !important; }

  /* Overlay internals are global because some of them are created by the script. */
  .bi-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  }
  .bi-cursor {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    overflow: visible;
    z-index: 2;
  }
  .bi-cursor path {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .bi-caret {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
  }
  .bi-line {
    position: absolute;
    width: 1px;
    height: 1px;
  }
  .bi-rule { background: color-mix(in srgb, var(--muted) 35%, transparent); }

  /* A text frame, as in a design tool: thin selection rectangle, corner handles, size label. */
  .bi-frame {
    position: absolute;
    border: 1px solid var(--accent);
  }
  .bi-frame i {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .bi-frame i:nth-child(1) { left: -3px; top: -3px; }
  .bi-frame i:nth-child(2) { right: -3px; top: -3px; }
  .bi-frame i:nth-child(3) { left: -3px; bottom: -3px; }
  .bi-frame i:nth-child(4) { right: -3px; bottom: -3px; }
  .bi-size {
    position: absolute;
    left: -1px;
    top: calc(100% + var(--space-1));
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    line-height: 1.3;
    color: var(--accent);
    white-space: nowrap;
  }

  .bi-skip {
    position: fixed;
    right: var(--gutter);
    bottom: var(--space-4);
    z-index: 20;
    padding: var(--space-2) var(--space-3);
    color: var(--muted);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease);
  }
  .bi-skip:hover { color: var(--accent); }
  .bi-skip[hidden] { display: none; }
</style>

<script>
  import { animate } from "motion/mini";

  const EASE: [number, number, number, number] = [0.2, 0, 0, 1]; // --ease
  const MS_PER_CHAR = { display: 45, label: 35, body: 17 }; // DESIGN.md §7
  const FRAME_PAD = 3; // px between a text frame and its text

  type Box = { x: number; y: number; w: number; h: number };
  type Task = (a: Agent) => Promise<void>;
  class Aborted extends Error {}

  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>("[data-bi-overlay]")!;
  const skipBtn = document.querySelector<HTMLButtonElement>("[data-bi-skip]")!;
  const cursorEls = [...overlay.querySelectorAll<SVGElement>("[data-bi-cursor]")];
  const caretEls = [...overlay.querySelectorAll<HTMLElement>("[data-bi-caret]")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  const q = <T extends Element = HTMLElement>(s: string, from: ParentNode = document) => from.querySelector<T>(s);
  const qa = <T extends Element = HTMLElement>(s: string, from: ParentNode = document) => [...from.querySelectorAll<T>(s)];
  /** Page (document) coordinates, so the overlay stays aligned while the page scrolls. */
  const box = (el: Element): Box => {
    const r = el.getBoundingClientRect();
    return { x: r.left + scrollX, y: r.top + scrollY, w: r.width, h: r.height };
  };
  const travel = (dist: number) => Math.min(0.7, Math.max(0.3, dist / 1600));

  /** One build of the page: shared state, a queue of tasks, and the agents that do them. */
  class Director {
    aborted = false;
    queue: Task[] = [];
    pendingUnits = 0;
    busy = 0;
    live = new Set<{ cancel(): void }>();
    typed = new Map<HTMLElement, string>();
    lines: HTMLElement[] = []; // overlay pieces (lines, frames) removed when the build ends
    trailing = new Set<Promise<unknown>>(); // fades nobody waits on
    rowLines = new Map<HTMLElement, HTMLElement[]>();
    agents: Agent[] = [];
    stopListening: (() => void) | null = null;
    private wakers: (() => void)[] = [];
    private idlers: (() => void)[] = [];

    check() { if (this.aborted) throw new Aborted(); }
    wake() { for (const w of this.wakers.splice(0)) w(); }
    push(tasks: Task[]) { this.queue.push(...tasks); this.wake(); }
    settled() {
      if (this.busy === 0 && this.queue.length === 0) for (const r of this.idlers.splice(0)) r();
    }
    whenIdle() { return new Promise<void>((r) => { this.idlers.push(r); this.settled(); }); }
    /** Next task, waiting for one if sections are still to come; null when nothing is left. */
    async next(): Promise<Task | null> {
      for (;;) {
        this.check();
        const t = this.queue.shift();
        if (t) return t;
        if (this.pendingUnits === 0) return null;
        await new Promise<void>((r) => this.wakers.push(r));
      }
    }
    async play(el: Element, keyframes: Record<string, unknown>, opts: Record<string, unknown> = {}) {
      this.check();
      const a = animate(el, keyframes as any, { ease: EASE, ...opts });
      this.live.add(a);
      try { await a; } finally { this.live.delete(a); }
      this.check();
    }
    /** Run a step every frame for `dur` seconds, with progress 0..1. */
    tween(dur: number, step: (p: number) => void) {
      this.check();
      return new Promise<void>((resolve, reject) => {
        const t0 = performance.now();
        const frame = (now: number) => {
          if (this.aborted) return reject(new Aborted());
          const p = Math.min(1, (now - t0) / 1000 / dur);
          step(p);
          if (p < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });
    }
    /** Start an animation without waiting for it (it's still cancelled by Skip). */
    later(p: Promise<unknown>) {
      const q = p.catch(() => {});
      this.trailing.add(q);
      q.then(() => this.trailing.delete(q));
    }
    updateSkip() { skipBtn.hidden = !this.agents.some((a) => a.present); }
  }

  class Agent {
    x = 0;
    y = 0;
    present = false;
    constructor(private d: Director, private el: SVGElement, private caret: HTMLElement) {}

    wait(ms: number) { return new Promise((r) => setTimeout(r, ms)).then(() => this.d.check()); }
    play(el: Element, kf: Record<string, unknown>, opts?: Record<string, unknown>) { return this.d.play(el, kf, opts); }

    place(x: number, y: number) {
      this.x = x; this.y = y;
      this.el.style.transform = `translate(${x}px, ${y}px)`;
    }
    enter(x: number, y: number, fade = false) {
      this.place(x, y);
      this.el.style.opacity = "1";
      if (fade) this.d.later(this.play(this.el, { opacity: [0, 1] }, { duration: 0.2 }));
      this.present = true;
      this.d.updateSkip();
    }
    /** Come back in from a side edge of the current screen. */
    arrive() {
      const left = Math.random() < 0.5;
      this.enter(left ? -20 : innerWidth + 20, scrollY + innerHeight * (0.3 + Math.random() * 0.5));
    }
    async move(x: number, y: number, duration = travel(Math.hypot(x - this.x, y - this.y))) {
      if (Math.hypot(x - this.x, y - this.y) < 1) return this.d.check(); // already there
      const from = `translate(${this.x}px, ${this.y}px)`;
      this.place(x, y);
      await this.play(this.el, { transform: [from, this.el.style.transform] }, { duration });
    }
    async leave() {
      const x = this.x - scrollX < innerWidth / 2 ? -40 : innerWidth + 40;
      this.el.style.opacity = "0";
      await Promise.all([this.move(x, this.y, 0.6), this.play(this.el, { opacity: [1, 0] }, { duration: 0.6 })]);
      this.present = false;
      this.d.updateSkip();
    }

    /** Type an element's text one character at a time behind a caret. The cursor follows
        the caret, unless it's holding a frame (then only the caret moves). */
    async type(el: HTMLElement | null, msPerChar: number, follow = true) {
      if (!el) return;
      const text = this.d.typed.get(el);
      const spans = [...el.children] as HTMLElement[];
      if (text === undefined || !spans.length) return;
      if (follow) {
        const first = box(spans[0]);
        await this.move(first.x, first.y + first.h + 2);
        await this.wait(50);
      }
      const c = this.caret;
      c.style.opacity = "1";
      for (let i = 0; i < spans.length; i++) {
        spans[i].style.visibility = "visible";
        const r = box(spans[i]);
        c.style.height = `${r.h}px`;
        c.style.transform = `translate(${r.x + r.w}px, ${r.y}px)`;
        // The cursor drifts along with the caret, a word at a time.
        if (follow && (text[i] === " " || i === spans.length - 1)) {
          this.move(r.x + r.w, r.y + r.h + 2, 0.25).catch(() => {});
        }
        await this.wait(msPerChar * (0.6 + Math.random() * 0.8));
      }
      c.style.opacity = "0";
      // Done: put the plain text back.
      el.textContent = text;
      this.d.typed.delete(el);
      await this.wait(50);
    }

    /** Lay out a text element like a design tool (ADR 0014): drag out a frame from its
        top-left corner to full size, with a size label that fades, then set the text in
        (typed behind a caret, or a short fade and rise). The frame fades once the text lands. */
    async frame(el: HTMLElement | null, set: "type" | "rise") {
      if (!el) return;
      const b = box(el);
      const x = b.x - FRAME_PAD, y = b.y - FRAME_PAD;
      const w = b.w + 2 * FRAME_PAD, h = b.h + 2 * FRAME_PAD;
      await this.move(x, y);
      const f = document.createElement("div");
      f.className = "bi-frame";
      f.innerHTML = "<i></i><i></i><i></i><i></i><span class='bi-size'></span>";
      f.style.left = `${x}px`;
      f.style.top = `${y}px`;
      overlay.append(f);
      this.d.lines.push(f);
      const size = f.querySelector<HTMLElement>(".bi-size")!;
      const w0 = Math.min(w, 16), h0 = Math.min(h, 10);
      await this.d.tween(0.45, (p) => {
        const e = ease(p);
        const fw = w0 + (w - w0) * e, fh = h0 + (h - h0) * e;
        f.style.width = `${fw}px`;
        f.style.height = `${fh}px`;
        this.place(x + fw, y + fh);
        size.textContent = `W ${Math.round(fw - 2 * FRAME_PAD)} · H ${Math.round(fh - 2 * FRAME_PAD)}`;
      });
      this.d.later(this.play(size, { opacity: [1, 0] }, { duration: 0.4, delay: 0.1 }));
      el.style.opacity = "1";
      if (set === "type") await this.type(el, MS_PER_CHAR.display, false);
      else await this.play(el, { opacity: [0, 1], transform: ["translateY(4px)", "none"] }, { duration: 0.3 });
      this.d.later(this.play(f, { opacity: [1, 0] }, { duration: 0.3 }).then(() => f.remove()));
    }

    /** Draw a 1px horizontal or vertical line from one point to another, cursor moving along. */
    async draw(x1: number, y1: number, x2: number, y2: number, kind: "bi-rule") {
      const h = y1 === y2;
      const line = document.createElement("span");
      line.className = `bi-line ${kind}`;
      line.style.left = `${Math.min(x1, x2)}px`;
      line.style.top = `${Math.min(y1, y2)}px`;
      line.style[h ? "width" : "height"] = `${Math.abs(h ? x2 - x1 : y2 - y1)}px`;
      line.style.transformOrigin = h ? (x2 >= x1 ? "left" : "right") : (y2 >= y1 ? "top" : "bottom");
      const from = h ? "scaleX(0)" : "scaleY(0)";
      line.style.transform = from;
      overlay.append(line);
      this.d.lines.push(line);
      await this.move(x1, y1);
      const dur = Math.min(0.6, Math.max(0.35, Math.hypot(x2 - x1, y2 - y1) / 2000));
      line.style.transform = "none";
      await Promise.all([
        this.play(line, { transform: [from, h ? "scaleX(1)" : "scaleY(1)"] }, { duration: dur }),
        this.move(x2, y2, dur),
      ]);
      return line;
    }

    /** Bring a box in small and out of place, drag it to its spot, then resize it. */
    async drag(el: HTMLElement, to: Box, from: { dx: number; dy: number; s: number }) {
      const at = (dx: number, dy: number, s: number) => `translate(${dx}px, ${dy}px) scale(${s})`;
      const grab = Math.min(10, to.w * from.s * 0.3);
      await this.move(to.x + from.dx + grab, to.y + from.dy + grab);
      el.style.transform = at(from.dx, from.dy, from.s);
      el.style.opacity = "1";
      await this.play(el, { opacity: [0, 1] }, { duration: 0.2 });
      await this.wait(100);
      el.style.transform = at(0, 0, from.s);
      await Promise.all([
        this.play(el, { transform: [at(from.dx, from.dy, from.s), el.style.transform] }, { duration: 0.6 }),
        this.move(to.x + grab, to.y + grab, 0.6),
      ]);
      await this.move(to.x + to.w * from.s, to.y + to.h * from.s, 0.3);
      await this.wait(50);
      el.style.transform = "none";
      await Promise.all([
        this.play(el, { transform: [at(0, 0, from.s), at(0, 0, 1)] }, { duration: 0.5 }),
        this.move(to.x + to.w, to.y + to.h, 0.5),
      ]);
    }
  }

  const FRAME_STYLES = ["opacity", "transform"] as const;
  const DRAG_STYLES = ["opacity", "transform", "transformOrigin", "outline", "outlineOffset"] as const;
  const release = (el: HTMLElement) => { for (const p of DRAG_STYLES) el.style[p] = ""; };

  /** Measure the finished layout, then put every element in its "not made yet" state. */
  function prepare(d: Director) {
    root.classList.add("b-active");
    for (const el of qa("[data-type]")) {
      const text = (el.textContent ?? "").replace(/\s+/g, " ").trim();
      el.textContent = "";
      for (const ch of text) {
        const s = document.createElement("span");
        s.textContent = ch;
        s.style.visibility = "hidden";
        el.append(s);
      }
      d.typed.set(el, text);
    }
    for (const el of qa("[data-frame]")) el.style.opacity = "0";
    const boxes = new Map(qa("[data-drag]").map((el) => [el, box(el)]));
    for (const el of boxes.keys()) {
      el.style.opacity = "0";
      el.style.transformOrigin = "top left";
      el.style.outline = "1px solid var(--accent)";
      el.style.outlineOffset = "2px";
    }
    // The constellation's stars, stardust, figures and labels are placed by an agent.
    for (const el of qa<Element & ElementCSSInlineStyle>("[data-c-node], [data-c-label-for], [data-c-dust], [data-c-fig]")) el.style.opacity = "0";
    root.classList.remove("is-building");
    overlay.style.height = `${root.scrollHeight}px`;
    overlay.hidden = false;
    return boxes;
  }

  function finish() {
    const d = current;
    if (d) {
      d.aborted = true;
      d.wake();
      d.stopListening?.();
      for (const a of d.live) { try { a.cancel(); } catch {} }
      for (const [el, text] of d.typed) el.textContent = text;
      for (const l of d.lines) l.remove();
    }
    for (const el of qa("[data-drag]")) release(el);
    for (const el of qa("[data-frame]")) for (const p of FRAME_STYLES) el.style[p] = "";
    for (const el of qa<Element & ElementCSSInlineStyle>("[data-c-node], [data-c-label-for], [data-c-dust], [data-c-fig]")) {
      el.style.opacity = "";
      el.style.transform = "";
    }
    for (const l of qa<SVGLineElement>("[data-c-line]")) { l.style.strokeDasharray = ""; l.style.strokeDashoffset = ""; }
    q("[data-c-fx]")?.replaceChildren();
    for (const r of qa("[data-row]")) delete r.dataset.built;
    for (const c of cursorEls) { c.style.opacity = ""; c.style.transform = ""; }
    for (const c of caretEls) c.style.opacity = "";
    overlay.hidden = true;
    skipBtn.hidden = true;
    root.classList.remove("is-building", "b-active");
    try { sessionStorage.setItem("built", "1"); } catch {}
    current = null;
  }

  /** cubic-bezier(x1, y1, x2, y2) as a function of progress, for motion driven frame by frame. */
  const bezier = (x1: number, y1: number, x2: number, y2: number) => (x: number) => {
    let lo = 0, hi = 1, t = x;
    for (let i = 0; i < 24; i++) {
      t = (lo + hi) / 2;
      const bx = 3 * (1 - t) ** 2 * t * x1 + 3 * (1 - t) * t ** 2 * x2 + t ** 3;
      if (bx < x) lo = t; else hi = t;
    }
    return 3 * (1 - t) ** 2 * t * y1 + 3 * (1 - t) * t ** 2 * y2 + t ** 3;
  };
  const ease = bezier(...EASE);
  /** The time (0..1) at which an eased motion reaches progress p. */
  const easeInverse = (p: number) => {
    let lo = 0, hi = 1;
    for (let i = 0; i < 24; i++) { const m = (lo + hi) / 2; if (ease(m) < p) lo = m; else hi = m; }
    return (lo + hi) / 2;
  };

  let current: Director | null = null;

  async function build() {
    if (current) return;
    if (reduce.matches) return finish();
    const d = new Director();
    current = d;
    clearTimeout((window as any).__buildFailsafe);
    // Positions depend on web fonts; don't wait longer than 600ms for them.
    await Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 600))]);
    if (d.aborted) return;

    const boxes = prepare(d);
    const vw = innerWidth, vh = innerHeight, top = scrollY;
    const onScreen = (el: Element) => box(el).y < top + vh;
    const [a1, a2, a3, a4, a5] = (d.agents = cursorEls.map((c, i) => new Agent(d, c, caretEls[i])));

    const figure = q("[data-constellation]")!;
    const workLabel = q("#work-title")!;
    const rows = qa("[data-row]");
    const rowBoxes = new Map(rows.map((r) => [r, box(r)]));

    // ---- Building blocks shared by the first screen and later sections ----
    const markBuilt = (row: HTMLElement) => {
      row.dataset.built = "";
      for (const l of d.rowLines.get(row) ?? []) l.remove();
    };
    /** A row's own hairlines: its top edge, plus the bottom edge for the last row. */
    const drawRowRules = async (a: Agent, row: HTMLElement) => {
      const b = rowBoxes.get(row)!;
      const ys = [b.y];
      if (row === rows[rows.length - 1]) ys.push(b.y + b.h - 1);
      for (const [i, y] of ys.entries()) {
        const ltr = i % 2 === 0;
        const line = await a.draw(ltr ? b.x : b.x + b.w, y, ltr ? b.x + b.w : b.x, y, "bi-rule");
        if ("built" in row.dataset) line.remove();
        else d.rowLines.set(row, [...(d.rowLines.get(row) ?? []), line]);
      }
    };
    const rowTask = (row: HTMLElement): Task => async (a) => {
      await drawRowRules(a, row);
      await a.type(q("h3", row), MS_PER_CHAR.label);
      await a.type(q(".blurb", row), MS_PER_CHAR.body);
      await a.type(q(".meta", row), MS_PER_CHAR.label);
      markBuilt(row);
    };
    const typeTask = (el: HTMLElement | null, ms: number): Task => (a) => a.type(el, ms);
    const caption = q("figcaption", figure);
    const figureTask: Task = async (a) => {
      await placeNodes(a);
      await a.frame(caption, "rise");
    };
    /** The commit constellation (DESIGN.md §8, ADR 0011). The agent sweeps outward from the
        center on a smooth spiral; stars ripple in as it passes (a quick scale-up, and a
        faint ping ring on the ones it places itself), with a short fading trail. Stardust
        fades in ring by ring behind it, and the constellation lines draw last. About 2s. */
    const placeNodes = async (a: Agent) => {
      const nodes = qa<SVGAElement>("[data-c-node]", figure);
      const svg = q<SVGSVGElement>(".c-sky svg", figure);
      const fx = q<SVGGElement>("[data-c-fx]", figure);
      if (!nodes.length || !svg || !fx) return;
      const NS = "http://www.w3.org/2000/svg";
      const SWEEP = 1.7, RIPPLE = 0.004, TRAIL = 0.2, TRAIL_MAX = 8, TURNS = 1.75; // s, s/unit, s, units, turns
      const sb = svg.getBoundingClientRect();
      const vb = svg.viewBox.baseVal;
      const toPage = (x: number, y: number) => [
        sb.left + scrollX + ((x - vb.x) / vb.width) * sb.width,
        sb.top + scrollY + ((y - vb.y) / vb.height) * sb.height,
      ] as const;
      const stars = nodes.map((el) => {
        const x = Number(el.dataset.x), y = Number(el.dataset.y);
        return { el, x, y, r: Number(el.dataset.r), dist: Math.hypot(x - 50, y - 50), placed: !!q(".c-halo", el), at: 0 };
      });
      const R = Math.max(...stars.map((st) => st.dist)) + 1;
      const last = stars[stars.length - 1];
      const a0 = Math.atan2(last.y - 50, last.x - 50) - TURNS * 2 * Math.PI; // ends on the newest
      const spiral = (p: number) => {
        const ang = a0 + p * TURNS * 2 * Math.PI;
        return [50 + R * p * Math.cos(ang), 50 + R * p * Math.sin(ang)] as const;
      };
      // Each star appears when the sweep reaches its distance from the center, a little
      // later the farther it is from the cursor at that moment (the ripple).
      for (const st of stars) {
        const p = Math.min(1, st.dist / R);
        const [cx, cy] = spiral(p);
        st.at = easeInverse(p) * SWEEP + Math.hypot(st.x - cx, st.y - cy) * RIPPLE;
      }
      // The agent places a few itself: the bright ones, plus any it passes right over.
      let extra = 0;
      for (const st of stars) {
        if (st.placed) continue;
        const [cx, cy] = spiral(Math.min(1, st.dist / R));
        if (Math.hypot(st.x - cx, st.y - cy) < 3 && extra < 12) { st.placed = true; extra++; }
      }
      const pending = [...stars].sort((p, q) => p.at - q.at);
      const dustBands = qa<SVGGElement>("[data-c-dust]", figure).map((g) => {
        // The band's outer edge (6 rings out to radius 46, see lib/constellation.ts).
        const outer = Math.min(1, (((Number(g.dataset.cDust) + 1) / 6) * 46) / R);
        return { g, at: easeInverse(outer) * SWEEP + 0.15 };
      });
      const end = Math.max(SWEEP, ...stars.map((st) => st.at)) + 0.15;

      const [sx, sy] = toPage(...spiral(0));
      await a.move(sx, sy);
      const trail = document.createElementNS(NS, "path");
      trail.setAttribute("class", "c-trail");
      fx.append(trail);
      const history: [number, number, number][] = [];
      const appearing: Promise<unknown>[] = [];
      const dusting: Promise<unknown>[] = []; // not waited on: lines start while dust fades in
      const shown = new Set<(typeof dustBands)[number]>();
      const ping = (st: (typeof stars)[number]) => {
        const ring = document.createElementNS(NS, "circle");
        ring.setAttribute("class", "c-ping");
        ring.setAttribute("cx", String(st.x));
        ring.setAttribute("cy", String(st.y));
        ring.setAttribute("r", String(st.r + 2.2));
        ring.style.transformBox = "fill-box";
        ring.style.transformOrigin = "center";
        ring.setAttribute("vector-effect", "non-scaling-stroke");
        fx.append(ring);
        appearing.push(a.play(ring, { opacity: [0.5, 0], transform: ["scale(0.3)", "scale(1)"] }, { duration: 0.3 })
          .finally(() => ring.remove()));
      };

      const t0 = performance.now();
      await new Promise<void>((resolve, reject) => {
        const frame = (now: number) => {
          if (d.aborted) return reject(new Aborted());
          const t = (now - t0) / 1000;
          const [x, y] = spiral(ease(Math.min(1, t / SWEEP)));
          const [px, py] = toPage(x, y);
          a.place(px, py);
          history.push([t, x, y]);
          while (history.length && history[0][0] < t - TRAIL) history.shift();
          // Keep the trail short even where the cursor moves fast.
          let length = 0;
          for (let k = history.length - 1; k > 0; k--) {
            length += Math.hypot(history[k][1] - history[k - 1][1], history[k][2] - history[k - 1][2]);
            if (length > TRAIL_MAX) { history.splice(0, k); break; }
          }
          trail.setAttribute("d", history.map(([, hx, hy], i) => `${i ? "L" : "M"}${hx} ${hy}`).join(""));
          while (pending.length && pending[0].at <= t) {
            const st = pending.shift()!;
            appearing.push(a.play(st.el, { opacity: [0, 1], transform: ["scale(0.3)", "scale(1.25)", "scale(1)"] }, { duration: 0.3 }));
            if (st.placed) ping(st);
          }
          for (const b of dustBands) {
            if (b.at <= t && !shown.has(b)) {
              shown.add(b);
              dusting.push(a.play(b.g, { opacity: [0, 1] }, { duration: 0.5 }));
            }
          }
          // The sweep stops at SWEEP and end is later than SWEEP + TRAIL, so the trail has
          // already shrunk to nothing by the time the loop ends.
          if (t < end) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });
      trail.remove();
      // The last stars are still settling; the lines start now and they're tidied up after.
      const placing = Promise.all(appearing);
      Promise.all(dusting).then(() => { for (const b of dustBands) b.g.style.opacity = ""; }, () => {});

      // Constellation lines last: the agent visits each milestone and its figure draws out
      // from it. About 1.2s in all, however many milestones there are.
      const figs = qa<SVGGElement>("[data-c-fig]", figure);
      const each = Math.min(0.5, 1.2 / Math.max(1, figs.length));
      for (const g of figs) {
        g.style.opacity = "";
        const lines = qa<SVGLineElement>("[data-c-line]", g);
        for (const l of lines) { l.style.strokeDasharray = "1"; l.style.strokeDashoffset = "1"; }
        const star = q<SVGAElement>(`[data-c-node][data-tags][data-fig="${g.dataset.cFig}"]`, figure);
        if (star) { const b = box(star); await a.move(b.x + b.w / 2, b.y + b.h / 2, Math.max(0.2, each * 0.6)); }
        const label = q<HTMLElement>(`[data-c-label-for="${g.dataset.cFig}"]`, figure);
        await Promise.all([
          ...lines.map((l) => a.play(l, { strokeDashoffset: ["1", "0"] }, { duration: each })),
          label ? a.play(label, { opacity: [0, 1] }, { duration: each }) : null,
        ]);
      }
      for (const el of qa<Element & ElementCSSInlineStyle>("[data-c-label-for]", figure)) el.style.opacity = "";
      for (const l of qa<SVGLineElement>("[data-c-line]", figure)) { l.style.strokeDasharray = ""; l.style.strokeDashoffset = ""; }
      await placing;
      for (const st of stars) { st.el.style.opacity = ""; st.el.style.transform = ""; }
    };

    // ---- Everything after the hero: built once the hero is done, as it scrolls into view ----
    // (Sections already on screen start right after the hero.)
    const units: [Element, Task[]][] = [];
    const skyNow = onScreen(figure);
    if (!skyNow) units.push([figure, [figureTask]]);
    units.push([workLabel, [typeTask(workLabel, MS_PER_CHAR.label)]]);
    for (const r of rows) units.push([r, [rowTask(r)]]);
    const about = q("#about")!;
    units.push([about, [typeTask(q("#about-title"), MS_PER_CHAR.label), typeTask(q("p", about), MS_PER_CHAR.body)]]);
    const contact = q("#contact")!;
    units.push([contact, [
      typeTask(q("#contact-title"), MS_PER_CHAR.label),
      ...qa("[data-contact]").map((li): Task => async (a) => {
        for (const el of qa("[data-type]", li)) await a.type(el, MS_PER_CHAR.label);
      }),
    ]]);
    const footer = q("[data-footer]")!;
    const replay = q("[data-drag='replay']")!;
    units.push([footer, [
      typeTask(q("p", footer), MS_PER_CHAR.label),
      async (a) => {
        await a.drag(replay, boxes.get(replay)!, { dx: -120, dy: -40, s: 0.6 });
        release(replay);
      },
    ]]);
    d.pendingUnits = units.length;
    const waiting = units.map(([el, tasks]) => ({ top: box(el).y, tasks }));
    /** A section starts once its top is 15% into the screen, or visible at the page's end. */
    const checkUnits = () => {
      const bottom = scrollY + innerHeight;
      const atEnd = bottom >= root.scrollHeight - 2;
      // Top to bottom, so sections revealed together are built in reading order.
      for (const u of [...waiting]) {
        if (u.top < bottom - innerHeight * 0.15 || (atEnd && u.top < bottom)) {
          waiting.splice(waiting.indexOf(u), 1);
          d.pendingUnits--;
          d.push(u.tasks);
        }
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; checkUnits(); });
    };

    // ---- The hero (ADR 0014): a crew working in parallel, about 2.5s in all ----
    // Each agent appears near its first job; the starts are staggered slightly so it reads
    // as a crew rather than everything at once.
    const after = (ms: number) => new Promise((r) => setTimeout(r, ms)).then(() => d.check());
    const near = (a: Agent, el: Element | null, dx: number, dy: number) => {
      const b = el ? box(el) : { x: vw / 2, y: top + vh / 2 };
      a.enter(b.x + dx, b.y + dy, true);
    };
    const greeting = q(".intro .greeting"), name = q("#intro-title"), tagline = q(".intro .tagline");
    const home = q("header .home"), nav = q("header nav");
    const intros: (() => Promise<void>)[] = [
      // Sky: the constellation, untouched (ADR 0011); it starts on the center, no walk-in.
      async () => {
        if (!skyNow) return;
        const svg = box(q(".c-sky svg", figure)!);
        a1.enter(svg.x + svg.w / 2, svg.y + svg.h / 2, true);
        await placeNodes(a1);
      },
      // The small lines around the name.
      async () => {
        near(a2, greeting, -48, -24);
        await a2.frame(greeting, "rise");
        await a2.frame(tagline, "rise");
      },
      // The name: frame, then typed in.
      async () => {
        await after(150);
        near(a3, name, -40, 40);
        await a3.frame(name, "type");
      },
      // The header: the home link, then the nav.
      async () => {
        await after(80);
        near(a4, home, 40, 40);
        await a4.frame(home, "rise");
        await a4.frame(nav, "rise");
      },
      // The sky's caption.
      async () => {
        if (!skyNow) return;
        await after(450);
        near(a5, caption, 40, 32);
        await a5.frame(caption, "rise");
      },
    ];

    /** After its intro, an agent takes tasks as they come, leaving when there's nothing to do. */
    const work = async (a: Agent) => {
      for (;;) {
        if (a.present && d.queue.length === 0) await a.leave();
        const task = await d.next();
        if (!task) return;
        if (!a.present) a.arrive();
        d.busy++;
        try { await task(a); } finally { d.busy--; d.settled(); }
      }
    };

    try {
      d.busy += intros.length;
      const introsDone = intros.map((intro) => intro().finally(() => { d.busy--; d.settled(); }));
      const everyone = d.agents.map((a, i) => introsDone[i].then(() => work(a)));
      // The hero is done once every intro is and the frames have faded; then the rest of
      // the page starts building as it comes into view.
      await Promise.all(introsDone);
      await d.whenIdle();
      await Promise.all(d.trailing);
      d.check();
      try { sessionStorage.setItem("built", "1"); } catch {}
      addEventListener("scroll", onScroll, { passive: true });
      d.stopListening = () => removeEventListener("scroll", onScroll);
      checkUnits();
      await Promise.all(everyone);
      finish();
    } catch (e) {
      if (!(e instanceof Aborted)) { finish(); throw e; }
    }
  }

  if (root.classList.contains("is-building")) build();

  skipBtn.addEventListener("click", finish);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && current) finish(); });
  let lastWidth = innerWidth;
  addEventListener("resize", () => {
    // Positions were measured once; a real width change means they are stale.
    if (innerWidth !== lastWidth) { lastWidth = innerWidth; if (current) finish(); }
  });
  document.querySelector("[data-replay]")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "instant" });
    build();
  });
</script>
