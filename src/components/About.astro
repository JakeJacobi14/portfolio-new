---
import RegMarks from "./RegMarks.astro";
---
<section id="about" class="about section container grid" aria-labelledby="about-title">
  <RegMarks />
  <h2 id="about-title" class="label mono full" data-type>About</h2>
  <p data-type>
    Placeholder: a short paragraph in your own words. What you like building, what you're
    studying, and one or two things outside of code (Spanish, math, biking).
  </p>
</section>

<style>
  p { grid-column: 1 / -1; max-width: var(--measure); font-size: var(--text-md); }
  @media (min-width: 960px) { p { grid-column: 1 / 9; } }
</style>
