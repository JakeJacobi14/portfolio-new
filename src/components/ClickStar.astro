---
// Click star (DESIGN.md §7): a click on the page leaves a star where you clicked, which pops
// in with one very quiet chime, the site's only sound. Stars clicked close together join into
// a figure (the constellation builder), which fades out once you pause. Stars are pinned to
// the page, so they scroll away with the content you clicked on. Not on a 3D model, links, buttons or
// form fields, which already do something.
---
<style is:global>
  .click-star {
    position: absolute; /* page coordinates: it stays on the spot you clicked as you scroll */
    z-index: 60;
    width: 16px; /* the halo: 3.2 × the 5px core */
    height: 16px;
    margin: -8px 0 0 -8px; /* centered on the click; transforms stay free for the pop */
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--star-warm) 28%, transparent), transparent 70%);
    pointer-events: none;
    opacity: 0;
  }
  .click-star::after {
    content: "";
    position: absolute;
    inset: 5.5px; /* a 5px core in the middle */
    border-radius: 50%;
    background: var(--star-warm);
  }
  /* Constellation builder: a line between two click stars, like the milestone
     figures in the sky. 1px hairline in --muted at 35%, values already in DESIGN.md. */
  .click-line {
    position: absolute;
    z-index: 59; /* under the stars */
    height: 1px;
    margin-top: -0.5px;
    transform-origin: 0 50%;
    background: color-mix(in srgb, var(--muted) 35%, transparent);
    pointer-events: none;
  }
</style>

<script>
  const MAX = 12; // stars on screen at once
  const VOLUME = 0.05; // the chime, kept very quiet
  const IGNORE = "a, button, input, textarea, select, label, summary, dialog, [role='button'], [contenteditable], [data-stage]";

  const root = document.documentElement;
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  const css = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
  const ms = (v: string) => (v.endsWith("ms") ? parseFloat(v) : parseFloat(v) * 1000); // "300ms" or "0.3s"

  // ---- The chime: a soft, high bell. A note from a pentatonic scale (so any two clicks
  // sound fine together), a quieter fifth above it, and a faint shimmer two octaves up,
  // each ringing out over about a second. ----
  const NOTES = [1567.98, 1760, 2093, 2349.32, 2637.02]; // G6 A6 C7 D7 E7
  let audio: AudioContext | null = null;
  function chime() {
    try {
      audio ??= new AudioContext(); // made inside a click, so the browser allows it
      if (audio.state === "suspended") void audio.resume();
      const t = audio.currentTime;
      const f = NOTES[Math.floor(Math.random() * NOTES.length)];
      const out = audio.createGain();
      out.gain.value = VOLUME;
      out.connect(audio.destination);
      for (const [mult, level, ring] of [[1, 1, 1.1], [1.5, 0.35, 0.8], [4, 0.12, 0.4]] as const) {
        const osc = audio.createOscillator();
        osc.type = "sine";
        osc.frequency.value = f * mult;
        const env = audio.createGain();
        env.gain.setValueAtTime(0, t);
        env.gain.linearRampToValueAtTime(level, t + 0.005); // a soft strike, no click
        env.gain.exponentialRampToValueAtTime(0.0001, t + ring);
        osc.connect(env).connect(out);
        osc.start(t);
        osc.stop(t + ring + 0.05);
      }
    } catch {
      // No Web Audio: the star still shows, silently.
    }
  }

  // ---- The constellation builder (DESIGN.md §7) ----
  // Stars clicked close together, one after another, join into a figure: each new star is
  // linked to the nearest star already in it (so figures branch like the sky's milestone
  // figures instead of zig-zagging). A figure stays while you keep adding to it; once you
  // pause, or click far away, the whole figure fades out together.
  const HOLD = 3000; // ms a figure waits for its next star before fading
  const reach = () => Math.min(240, innerWidth * 0.45); // px: farther than this starts a new figure

  type Star = { x: number; y: number; el: HTMLElement };
  type Figure = { stars: Star[]; parts: HTMLElement[]; timer: number };
  let open: Figure | null = null;

  const easing = () => css("--ease") || "ease-out";

  function makeStar(x: number, y: number): Star {
    const el = document.createElement("span");
    el.className = "click-star";
    el.setAttribute("aria-hidden", "true");
    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    document.body.append(el);
    const keyframes = still.matches
      ? [{ opacity: 0 }, { opacity: 1 }]
      : [{ opacity: 0, transform: "scale(0.4)" }, { opacity: 1, transform: "scale(1)" }];
    el.animate(keyframes, { duration: ms(css("--dur-ui")) || 300, easing: easing(), fill: "forwards" });
    return { x, y, el };
  }

  function makeLine(a: Star, b: Star): HTMLElement {
    const el = document.createElement("span");
    el.className = "click-line";
    el.setAttribute("aria-hidden", "true");
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const angle = Math.atan2(dy, dx);
    el.style.left = `${a.x}px`;
    el.style.top = `${a.y}px`;
    el.style.width = `${Math.hypot(dx, dy)}px`;
    el.style.transform = `rotate(${angle}rad)`;
    document.body.append(el);
    // Drawn from the old star out to the new one, like the build-in's "draw".
    if (!still.matches) {
      el.animate(
        [{ transform: `rotate(${angle}rad) scaleX(0)` }, { transform: `rotate(${angle}rad) scaleX(1)` }],
        { duration: ms(css("--dur-ui")) || 300, easing: easing() },
      );
    }
    return el;
  }

  async function close(fig: Figure) {
    clearTimeout(fig.timer);
    if (open === fig) open = null;
    const fades = fig.parts.map((el) =>
      el.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: ms(css("--dur-click-star")) || 1600,
        easing: easing(),
        fill: "forwards",
      }).finished.catch(() => {}),
    );
    await Promise.all(fades);
    fig.parts.forEach((el) => el.remove());
  }

  function place(x: number, y: number) {
    let nearest: Star | null = null;
    let best = Infinity;
    for (const s of open?.stars ?? []) {
      const d = Math.hypot(s.x - x, s.y - y);
      if (d < best) [best, nearest] = [d, s];
    }

    const star = makeStar(x, y);
    if (open && nearest && best <= reach() && open.stars.length < MAX) {
      open.parts.push(makeLine(nearest, star), star.el);
      open.stars.push(star);
      clearTimeout(open.timer);
    } else {
      if (open) void close(open);
      open = { stars: [star], parts: [star.el], timer: 0 };
    }
    const fig = open;
    fig.timer = window.setTimeout(() => void close(fig), HOLD);
  }

  document.addEventListener("click", (e) => {
    if (e.detail === 0) return; // a click made with the keyboard
    if ((e.target as Element).closest?.(IGNORE)) return;
    if (String(getSelection() ?? "").length > 0) return; // the end of selecting text
    chime();
    void place(e.pageX, e.pageY);
  });
</script>
