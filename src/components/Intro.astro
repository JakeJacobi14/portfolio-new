---
import Constellation from "./Constellation.astro";
import ShootingStar from "./ShootingStar.astro";
---
<section class="intro" aria-labelledby="intro-title" data-hero>
  <div class="text">
    <!-- The tooltip sits beside the line, not in it, so a screen reader reads "сайн уу,
         I'm" and gives the translation as the description of "сайн уу". -->
    <div class="greet">
      <p class="greeting mono" data-frame>
        <span class="mn" lang="mn" tabindex="0" aria-describedby="greeting-tip">сайн уу</span>, I'm
      </p>
      <span class="tip mono" id="greeting-tip" role="tooltip" aria-hidden="true">hello, in Mongolian</span>
    </div>
    <h1 id="intro-title" data-frame data-type>Jake Jacobi</h1>
    <p class="tagline mono" data-frame>software engineer · building software that sees, thinks &amp; moves</p>
  </div>
  <Constellation />
  <ShootingStar />
</section>

<style>
  /* The hero fills exactly one screen (ADR 0015); the header sits on top of it. The name
     block and the sky are centered vertically in it. */
  .intro {
    position: relative;
    min-height: 100svh;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-9) var(--gutter) var(--space-8);
    display: grid;
    align-content: center;
    gap: var(--space-7);
  }
  /* One big element (the name); everything else is small (DESIGN.md §5, ADR 0013).
     Each line is only as wide as its text, so the build-in frames fit it tightly. */
  .text > * { width: fit-content; max-width: 100%; }

  .greet { position: relative; }
  .greeting { color: var(--muted); }
  .mn {
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
    text-underline-offset: 0.25em;
    cursor: help;
  }
  /* Same surface as the constellation tooltip. */
  .tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + var(--space-2));
    padding: var(--space-1) var(--space-2);
    white-space: nowrap;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: var(--radius);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-micro) var(--ease);
  }
  .greet:has(.mn:hover) .tip,
  .greet:has(.mn:focus) .tip { opacity: 1; }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-display);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
  }
  .tagline {
    margin-top: var(--space-4);
    color: var(--muted);
  }
  @media (min-width: 960px) {
    /* The text column is as wide as the name; the sky takes the rest, plus up to 64px of
       the page's right margin when there is one. The gap keeps the sky's faded edge (15%
       past the stars) clear of the name. */
    .intro {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: var(--space-9);
      align-items: center;
      padding-bottom: var(--space-9);
    }
    .intro :global(.constellation) {
      margin-right: calc(-1 * clamp(0px, (100vw - var(--page-max)) / 2, var(--space-8)));
    }
    /* Never taller than the screen leaves room for. */
    .intro :global(.c-frame) {
      width: min(100%, 100svh - 2 * var(--space-9) - var(--space-7));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tip { transition: none; }
  }
</style>

<script>
  // Escape dismisses the greeting's tooltip (WCAG 1.4.13).
  const mn = document.querySelector<HTMLElement>(".intro .mn");
  mn?.addEventListener("keydown", (e) => { if (e.key === "Escape") mn.blur(); });
</script>
