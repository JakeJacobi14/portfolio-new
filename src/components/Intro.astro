---
import RegMarks from "./RegMarks.astro";
import HeroFigure from "./HeroFigure.astro";
---
<section class="intro section container grid" aria-labelledby="intro-title">
  <RegMarks />
  <div class="text">
    <h1 id="intro-title" data-type>Jake Jacobi</h1>
    <p class="lede" data-type>
      Computer science student at Purdue, with minors in Spanish and math.
      From Oregon, now in Indiana.
    </p>
  </div>
  <HeroFigure />
</section>

<style>
  .intro {
    padding-block: var(--space-9) var(--space-7);
    row-gap: var(--space-8);
  }
  .text, .intro :global(.hero-figure) { grid-column: 1 / -1; }
  h1 {
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-md);
    color: var(--muted);
  }
  @media (min-width: 640px) {
    h1 { font-size: var(--text-3xl); }
  }
  @media (min-width: 960px) {
    .intro { align-items: center; padding-top: var(--space-8); }
    .text { grid-column: 1 / 8; }
    .intro :global(.hero-figure) { grid-column: 8 / -1; }
  }
</style>
