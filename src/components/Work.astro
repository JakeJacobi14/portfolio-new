---
import RegMarks from "./RegMarks.astro";
// Placeholder entries until real projects are chosen (DESIGN.md §8).
const projects = [
  { title: "This portfolio", blurb: "A site that builds itself, and a record of how it was made.", meta: "2026" },
  { title: "Project two (placeholder)", blurb: "One line on the problem and what you built.", meta: "Year" },
  { title: "Project three (placeholder)", blurb: "One line on the problem and what you built.", meta: "Year" },
];
---
<section id="work" class="work section container grid" aria-labelledby="work-title">
  <RegMarks />
  <h2 id="work-title" class="label mono full" data-type>Selected work</h2>
  <ul class="full rows">
    {projects.map((p) => (
      <li class="row" data-row>
        <h3 data-type>{p.title}</h3>
        <p class="blurb" data-type>{p.blurb}</p>
        <p class="meta mono" data-type>{p.meta}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .rows, .row {
    display: grid;
    grid-template-columns: subgrid;
  }
  .row {
    grid-column: 1 / -1;
    row-gap: var(--space-1);
    padding: var(--space-5) 0;
    border-top: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
  }
  .row:last-child { border-bottom: 1px solid color-mix(in srgb, var(--muted) 35%, transparent); }
  h3 { font-size: var(--text-md); font-weight: 500; }
  h3, .blurb { grid-column: 1 / -2; }
  .blurb { color: var(--muted); max-width: var(--measure); }
  .meta { grid-column: -2 / -1; grid-row: 1; justify-self: end; color: var(--muted); align-self: baseline; }
  @media (min-width: 960px) {
    h3, .blurb { grid-column: 1 / 9; }
  }
</style>
