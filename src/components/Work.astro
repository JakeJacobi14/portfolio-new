---
// 01 / selected work (DESIGN.md §8, ADR 0017): one row per project; the whole row links
// to its page.
import { getCollection } from "astro:content";
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="work" aria-labelledby="work-title">
  <h2 id="work-title" class="label mono" data-type>01 / selected work</h2>
  <ul>
    {projects.map(({ data }) => (
      <li class="row" data-row>
        <a class="link" href={`/work/${data.slug}`}>
          <h3 data-type transition:name={`work-${data.slug}`} transition:animate="initial">{data.title}</h3>
          <p class="blurb" data-type>{data.summary}</p>
          <p class="meta mono" data-type>{data.year}</p>
          <span class="arrow mono" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .work {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-9) var(--gutter);
  }
  .label { color: var(--muted); font-weight: 400; margin-bottom: var(--space-4); }
  .row {
    border-top: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
  }
  .row:last-child { border-bottom: 1px solid color-mix(in srgb, var(--muted) 35%, transparent); }
  .link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-5) 0;
    color: inherit;
    text-decoration: none;
  }
  .link:focus-visible { outline-offset: 4px; }
  h3 {
    font-size: var(--text-md);
    font-weight: 500;
    transition: color var(--dur-micro) var(--ease);
  }
  .blurb { grid-column: 1; color: var(--muted); max-width: var(--measure); }
  .meta { grid-column: 2; grid-row: 1; color: var(--muted); align-self: baseline; }
  .arrow {
    grid-column: 3;
    grid-row: 1;
    align-self: baseline;
    color: var(--muted);
    transition: transform var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease);
  }
  .link:hover h3, .link:focus-visible h3,
  .link:hover .arrow, .link:focus-visible .arrow { color: var(--accent); }
  .link:hover .arrow, .link:focus-visible .arrow { transform: translateX(4px); }
  /* While the rows are being built, the arrow waits for its row. */
  :global(.is-building) .arrow,
  :global(.b-active) .row:not([data-built]) .arrow { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .arrow { transition: color var(--dur-micro) var(--ease); }
    .link:hover .arrow, .link:focus-visible .arrow { transform: none; }
  }
</style>
