---
import "../styles/global.css";
import BuildIn from "../components/BuildIn.astro";
import ClickStar from "../components/ClickStar.astro";

interface Props {
  title: string;
  description?: string;
  /** Which build-in the page has, if any: the home page's, or a project page's (ADR 0020). */
  build?: "home" | "work";
}
const { title, description = "software engineer · building software that sees, thinks & moves", build } = Astro.props;
// Absolute URLs for link previews (Open Graph, Twitter) and the canonical link.
const url = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site); // no trailing slash, as linked
const image = new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171715" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <!-- ?v=3: a new URL, so browsers drop the old cached Astro icon (bump it on changes). -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jake Jacobi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jake Jacobi, next to a night sky where every star is a commit to this site." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <!-- Fonts are self-hosted (src/styles/fonts.css); these two are on every first screen. -->
    <link rel="preload" href="/fonts/schibsted-grotesk-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Runs before paint (ADR 0019): where the page starts, and whether the build-in plays.
         The build-in (home only) plays on every fresh load and refresh. It's skipped when
         coming back from a project page: by the browser's back button, or by a link to a
         section (like "back to work", /#work). -->
    <script is:inline define:vars={{ build: !!build }}>
      (() => {
        const nav = performance.getEntriesByType("navigation")[0];
        const back = nav?.type === "back_forward";
        let fromWork = false;
        try {
          const ref = new URL(document.referrer);
          fromWork = ref.origin === location.origin && ref.pathname.startsWith("/work/");
        } catch {}
        // Scroll positions are handled here: the browser doesn't restore them on its own.
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        const key = "scroll:" + location.pathname;
        addEventListener("pagehide", () => { try { sessionStorage.setItem(key, String(scrollY)); } catch {} });
        if (location.hash) {
          // A link to a section: go there, then drop the hash so a refresh starts at the top.
          addEventListener("DOMContentLoaded", () => {
            document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
            history.replaceState(history.state, "", location.pathname + location.search);
          });
        } else if (back) {
          // Back (or forward) to this page: return to where it was left.
          let y = 0;
          try { y = Number(sessionStorage.getItem(key)) || 0; } catch {}
          addEventListener("pagereveal", () => scrollTo(0, y), { once: true }); // before the first frame
          addEventListener("DOMContentLoaded", () => scrollTo(0, y));
          addEventListener("load", () => scrollTo(0, y), { once: true }); // after fonts and images settle
        } else {
          scrollTo(0, 0); // a fresh load or a refresh starts at the top
        }
        const d = document.documentElement;
        // Arriving with a view transition (a project title morphing in, ADR 0020).
        // The build-in waits for the transition to finish (window.__revealed, below).
        window.__revealed = new Promise((resolve) => {
          addEventListener("pagereveal", (e) => {
            if (!e.viewTransition) return resolve();
            d.classList.add("vt-in");
            e.viewTransition.ready.catch(() => {}); // a transition the browser skips isn't an error
            e.viewTransition.finished.then(resolve, resolve);
          }, { once: true });
        });
        const skip = !build || back || (!!location.hash && fromWork);
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !skip) {
          d.classList.add("is-building");
          // Fail-safe: never leave content hidden if the script doesn't run.
          window.__buildFailsafe = setTimeout(() => d.classList.remove("is-building"), 3500);
        }
      })();
    </script>
  </head>
  <body data-build={build}>
    <a class="skip-link mono" href="#main">Skip to content</a>
    <slot />
    {build && <BuildIn />}
    <ClickStar />
  </body>
</html>
