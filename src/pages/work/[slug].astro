---
// A project page (DESIGN.md §8, ADR 0017): problem → what I did → result → what I'd change.
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ModelViewer from "../../components/ModelViewer.astro";
import DemoEmbed from "../../components/DemoEmbed.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const facts = [
  ["role", data.role],
  ["team", data.team],
  ["year", data.year],
  ["stack", data.stack.join(", ")],
];
---
<Base title={`${data.title} · Jake Jacobi`} description={data.summary} build="work">
  <Header />
  <main id="main" class="page">
    <article>
      <div data-work-head>
        <a class="back mono" href="/#work" data-back data-frame>← back to work</a>
        <h1 data-work-title data-frame transition:name={`work-${data.slug}`} transition:animate="initial">{data.title}</h1>
        <p class="summary" data-summary data-frame>{data.summary}</p>
        <dl class="facts mono" data-facts data-frame>
          {facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        {data.links.length > 0 && (
          <ul class="links mono" data-links data-frame>
            {data.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}
          </ul>
        )}
        {data.model ? (
          <ModelViewer {...data.model} />
        ) : data.cover && !data.demo && (
          <Image class="cover" src={data.cover} loading="eager" alt={data.coverAlt ?? ""} widths={[640, 960, 1280]} sizes="(min-width: 760px) 680px, 100vw" data-cover data-frame />
        )}
      </div>
      {data.demo && data.cover && (
        <DemoEmbed url={data.demo} title={data.title} poster={data.cover} posterAlt={data.coverAlt ?? ""} />
      )}
      <div class="body">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-9) var(--gutter) var(--space-8);
  }
  .back { display: inline-block; color: var(--muted); text-decoration-color: transparent; }
  h1 { width: fit-content; }
  /* Before the build-in script runs, the sections wait to be built (ADR 0020). */
  :global(.is-building) .body > :global(*) { opacity: 0; }
  .back:hover, .back:focus-visible { text-decoration-color: currentColor; }
  /* Text keeps to the measure; a live demo takes the full page width. */
  [data-work-head], .body { max-width: var(--measure); }
  h1 {
    margin-top: var(--space-7);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
  }
  .summary { margin-top: var(--space-4); font-size: var(--text-md); color: var(--muted); }
  .facts {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0;
    border-block: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
  }
  .facts div { display: grid; grid-template-columns: 8ch 1fr; gap: var(--space-4); }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; margin-top: var(--space-4); color: var(--muted); }
  .links li + li::before { content: "·" / ""; margin: 0 var(--space-3); }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius);
  }
  .body { margin-top: var(--space-7); }
  .body :global(img), .body :global(video) { display: block; width: 100%; height: auto; margin: var(--space-4) 0 var(--space-5); border-radius: var(--radius); }
  .body :global(h2) {
    margin: var(--space-7) 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--muted);
  }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(ul) { display: grid; gap: var(--space-2); }
  .body :global(li) { padding-left: var(--space-4); text-indent: calc(-1 * var(--space-4)); }
  .body :global(li)::before { content: "–" / ""; display: inline-block; width: var(--space-4); text-indent: 0; color: var(--muted); }
  @media (min-width: 640px) {
    h1 { font-size: var(--text-3xl); }
  }
</style>
